From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Add selectable launcher icon styles

---
diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index 6ed7920..1e5d4d2 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -141,6 +141,12 @@ if (_is_default_toolchain) {
       "java/res_base/font/chrome_google_sans_text.xml",
       "java/res_base/font/chrome_google_sans_text_medium.xml",
       "java/res_base/values/values.xml",
+      "java/res_base/mipmap-nodpi/ic_launcher_hitam.png",
+      "java/res_base/mipmap-nodpi/ic_launcher_biru.png",
+      "java/res_base/mipmap-nodpi/ic_launcher_hijau.png",
+      "java/res_base/mipmap-nodpi/ic_launcher_kuning.png",
+      "java/res_base/mipmap-nodpi/ic_launcher_merah.png",
+
       "java/res_base/xml/network_security_config.xml",
       "java/res_chromium_base/drawable/themed_app_icon.xml",
       "java/res_chromium_base/mipmap-hdpi/app_icon.png",
diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
index 4f8d014..529cd24 100644
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -669,6 +669,61 @@ by a child template that "extends" this file.
             <property android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                 android:value="true" />
         </activity>
+        <!-- Launcher icon styles. Exactly one alias is enabled at a time. -->        <activity-alias android:name="com.google.android.apps.chrome.Main.hitam"
+            android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
+            android:exported="true"
+            android:enabled="true"
+            android:icon="@mipmap/ic_launcher_hitam"
+            android:roundIcon="@mipmap/ic_launcher_hitam">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity-alias>
+        <activity-alias android:name="com.google.android.apps.chrome.Main.biru"
+            android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
+            android:exported="true"
+            android:enabled="false"
+            android:icon="@mipmap/ic_launcher_biru"
+            android:roundIcon="@mipmap/ic_launcher_biru">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity-alias>
+        <activity-alias android:name="com.google.android.apps.chrome.Main.hijau"
+            android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
+            android:exported="true"
+            android:enabled="false"
+            android:icon="@mipmap/ic_launcher_hijau"
+            android:roundIcon="@mipmap/ic_launcher_hijau">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity-alias>
+        <activity-alias android:name="com.google.android.apps.chrome.Main.kuning"
+            android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
+            android:exported="true"
+            android:enabled="false"
+            android:icon="@mipmap/ic_launcher_kuning"
+            android:roundIcon="@mipmap/ic_launcher_kuning">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity-alias>
+        <activity-alias android:name="com.google.android.apps.chrome.Main.merah"
+            android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
+            android:exported="true"
+            android:enabled="false"
+            android:icon="@mipmap/ic_launcher_merah"
+            android:roundIcon="@mipmap/ic_launcher_merah">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity-alias>
         <activity-alias android:name="com.google.android.apps.chrome.Main"
             android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
             android:exported="true">
@@ -677,12 +732,8 @@ by a child template that "extends" this file.
             <intent-filter>
                 <action android:name="android.intent.action.MAIN" />
                 <category android:name="android.intent.category.DEFAULT" />
-                <category android:name="android.intent.category.LAUNCHER" />
                 <category android:name="android.intent.category.BROWSABLE" />
                 <category android:name="android.intent.category.APP_BROWSER" />
-                {% if channel in ['dev', 'canary', 'default'] %}
-                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
-                {% endif %}
             </intent-filter>
             <meta-data android:name="android.app.shortcuts"
                 android:resource="@xml/launchershortcuts" />
diff --git a/chrome/android/java/res/xml/main_preferences.xml b/chrome/android/java/res/xml/main_preferences.xml
index 67228cb..2277a0c 100644
--- a/chrome/android/java/res/xml/main_preferences.xml
+++ b/chrome/android/java/res/xml/main_preferences.xml
@@ -40,6 +40,11 @@ found in the LICENSE file.
         android:key="address_bar"
         android:order="7"
         android:title="@string/address_bar_settings"/>
+    <org.chromium.components.browser_ui.settings.ChromeBasePreference
+        android:fragment="org.chromium.chrome.browser.appicon.AppIconSettingsFragment"
+        android:key="app_icon"
+        android:order="70"
+        android:title="@string/app_icon_settings"/>
     <org.chromium.components.browser_ui.settings.ChromeBasePreference
         android:fragment="org.chromium.chrome.browser.privacy.settings.PrivacySettings"
         android:key="privacy"
diff --git a/chrome/android/java/res_base/mipmap-nodpi/ic_launcher_biru.png b/chrome/android/java/res_base/mipmap-nodpi/ic_launcher_biru.png
new file mode 100644
index 0000000000000000000000000000000000000000..b273e51c97032e1ba0748bec770b6633e7d8fa3e
