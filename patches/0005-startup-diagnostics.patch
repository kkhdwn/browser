From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Write startup breadcrumbs and crash data to Download

---
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/diagnostics/BrowserDiagnostics.java b/chrome/android/java/src/org/chromium/chrome/browser/diagnostics/BrowserDiagnostics.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/diagnostics/BrowserDiagnostics.java
@@ -0,0 +1,239 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.diagnostics;
+
+import android.app.Activity;
+import android.app.Application;
+import android.content.ContentResolver;
+import android.content.ContentUris;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Environment;
+import android.provider.MediaStore;
+import android.system.Os;
+import android.system.OsConstants;
+
+import org.chromium.base.CommandLine;
+import org.chromium.chrome.browser.flags.ChromeSwitches;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileDescriptor;
+import java.io.FileInputStream;
+import java.io.OutputStream;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Startup diagnostics for builds under investigation: breadcrumbs, Java crash stacks and native
+ * crash dumps are written to the public Download collection so they can be read without a PC.
+ * This class is removed once startup is understood.
+ */
+public final class BrowserDiagnostics {
+    private static final String FILE_NAME = "browser-diag.txt";
+    private static final StringBuilder BUFFER = new StringBuilder();
+    private static Uri sUri;
+    private static Application sApp;
+
+    private BrowserDiagnostics() {}
+
+    public static synchronized void install(Application application) {
+        try {
+            sApp = application;
+            final Thread.UncaughtExceptionHandler previous =
+                    Thread.getDefaultUncaughtExceptionHandler();
+            Thread.setDefaultUncaughtExceptionHandler(
+                    (thread, throwable) -> {
+                        StringWriter writer = new StringWriter();
+                        throwable.printStackTrace(new PrintWriter(writer));
+                        append("FATAL in " + thread.getName() + "\n" + writer);
+                        if (previous != null) previous.uncaughtException(thread, throwable);
+                    });
+            append("=== start model=" + Build.MODEL + " sdk=" + Build.VERSION.SDK_INT + " ===");
+            File nativeLog = new File(application.getCacheDir(), "native.log");
+            try {
+                FileDescriptor fd = Os.open(nativeLog.getPath(),
+                        OsConstants.O_WRONLY | OsConstants.O_CREAT | OsConstants.O_TRUNC, 0600);
+                Os.dup2(fd, 2);
+                Os.close(fd);
+                append("stderr redirected to " + nativeLog.getPath());
+            } catch (Throwable throwable) {
+                append("could not redirect stderr: " + throwable);
+            }
+            try {
+                CommandLine commandLine = CommandLine.getInstance();
+                commandLine.appendSwitch(ChromeSwitches.DISABLE_FIRST_RUN_EXPERIENCE);
+                commandLine.appendSwitch("disable-gpu-sandbox");
+                commandLine.appendSwitch("in-process-gpu");
+                commandLine.appendSwitchWithValue("enable-logging", "stderr");
+                commandLine.appendSwitchWithValue("v", "1");
+                append("first-run disabled, in-process gpu, native logging to stderr");
+            } catch (Throwable throwable) {
+                append("could not set switches: " + throwable);
+            }
+            copyCrashDumps(application);
+            sApp.registerActivityLifecycleCallbacks(
+                    new Application.ActivityLifecycleCallbacks() {
+                        @Override
+                        public void onActivityCreated(Activity activity, Bundle state) {
+                            append("activity created " + activity.getClass().getName());
+                        }
+
+                        @Override
+                        public void onActivityStarted(Activity activity) {
+                            append("activity started " + activity.getClass().getName());
+                        }
+
+                        @Override
+                        public void onActivityResumed(Activity activity) {
+                            append("activity resumed " + activity.getClass().getName());
+                        }
+
+                        @Override
+                        public void onActivityPaused(Activity activity) {}
+
+                        @Override
+                        public void onActivityStopped(Activity activity) {}
+
+                        @Override
+                        public void onActivitySaveInstanceState(Activity activity, Bundle state) {}
+
+                        @Override
+                        public void onActivityDestroyed(Activity activity) {}
+                    });
+        } catch (Throwable ignored) {
+            // Diagnostics must never break startup.
+        }
+    }
+
+    public static synchronized void append(String line) {
+        if (sApp == null) return;
+        try {
+            String stamp = new SimpleDateFormat("HH:mm:ss.SSS", Locale.US).format(new Date());
+            BUFFER.append(stamp).append(' ').append(line).append('\n');
+            if (BUFFER.length() > 200000) BUFFER.delete(0, BUFFER.length() - 200000);
+            ContentResolver resolver = sApp.getContentResolver();
+            Uri uri = ensureUri(resolver);
+            if (uri == null) return;
+            try (OutputStream out = resolver.openOutputStream(uri, "wt")) {
+                if (out != null) out.write(BUFFER.toString().getBytes(StandardCharsets.UTF_8));
+            }
+        } catch (Throwable ignored) {
+            // Ignore.
+        }
+    }
+
+    private static Uri ensureUri(ContentResolver resolver) {
+        if (sUri != null) return sUri;
+        Uri collection = MediaStore.Downloads.EXTERNAL_CONTENT_URI;
+        try (Cursor cursor = resolver.query(collection, new String[] {MediaStore.Downloads._ID},
+                MediaStore.Downloads.DISPLAY_NAME + "=?", new String[] {FILE_NAME}, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                sUri = ContentUris.withAppendedId(collection, cursor.getLong(0));
+                return sUri;
+            }
+        } catch (Throwable ignored) {
+            // Fall through to insert.
+        }
+        ContentValues values = new ContentValues();
+        values.put(MediaStore.Downloads.DISPLAY_NAME, FILE_NAME);
+        values.put(MediaStore.Downloads.MIME_TYPE, "text/plain");
+        values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);
+        sUri = resolver.insert(collection, values);
+        return sUri;
+    }
+
+    private static void copyCrashDumps(Application application) {
+        try {
+            File root = new File(application.getCacheDir(), "Crashpad");
+            if (!root.isDirectory()) {
+                append("no crashpad directory");
+                return;
+            }
+            List<File> dumps = new ArrayList<>();
+            collectDumps(root, dumps, 0);
+            append("native crash dumps found: " + dumps.size());
+            copyFileToDownloads(application, new File(application.getCacheDir(), "native.log"),
+                    "browser-native.log", "text/plain");
+            int copied = 0;
+            for (File dump : dumps) {
+                if (copied >= 3) break;
+                byte[] data = readFully(dump);
+                if (data == null || data.length == 0) continue;
+                ContentValues values = new ContentValues();
+                values.put(MediaStore.Downloads.DISPLAY_NAME, "browser-crash-" + dump.getName());
+                values.put(MediaStore.Downloads.MIME_TYPE, "application/octet-stream");
+                values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);
+                Uri uri = application.getContentResolver()
+                                  .insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
+                if (uri == null) continue;
+                try (OutputStream out =
+                                application.getContentResolver().openOutputStream(uri, "wt")) {
+                    if (out != null) out.write(data);
+                }
+                append("copied dump " + dump.getName() + " (" + data.length + " bytes)");
+                copied++;
+            }
+        } catch (Throwable throwable) {
+            append("dump copy failed: " + throwable);
+        }
+    }
+
+    private static void copyFileToDownloads(
+            Application application, File file, String name, String mimeType) {
+        try {
+            if (!file.isFile() || file.length() == 0) return;
+            byte[] data = readFully(file);
+            if (data == null) return;
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.Downloads.DISPLAY_NAME, name);
+            values.put(MediaStore.Downloads.MIME_TYPE, mimeType);
+            values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);
+            Uri uri = application.getContentResolver()
+                              .insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
+            if (uri == null) return;
+            try (OutputStream out = application.getContentResolver().openOutputStream(uri, "wt")) {
+                if (out != null) out.write(data);
+            }
+            append("copied " + name + " (" + data.length + " bytes)");
+        } catch (Throwable throwable) {
+            append("copy " + name + " failed: " + throwable);
+        }
+    }
+
+    private static void collectDumps(File directory, List<File> out, int depth) {
+        if (depth > 4) return;
+        File[] children = directory.listFiles();
+        if (children == null) return;
+        for (File child : children) {
+            if (child.isDirectory()) {
+                collectDumps(child, out, depth + 1);
+            } else if (child.getName().endsWith(".dmp")) {
+                out.add(child);
+            }
+        }
+    }
+
+    private static byte[] readFully(File file) {
+        try (FileInputStream input = new FileInputStream(file)) {
+            ByteArrayOutputStream output = new ByteArrayOutputStream();
+            byte[] chunk = new byte[16384];
+            int read;
+            while ((read = input.read(chunk)) > 0) output.write(chunk, 0, read);
+            return output.toByteArray();
+        } catch (Throwable throwable) {
+            return null;
+        }
+    }
+}
