From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Apply command line switches before the feature list is initialized

---
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java b/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java
index 19c3b81..5b8532f 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplication.java
@@ -20,6 +20,7 @@ import androidx.annotation.VisibleForTesting;
 import org.chromium.base.ApplicationState;
 import org.chromium.base.ApplicationStatus;
 import org.chromium.base.BundleUtils;
+import org.chromium.base.CommandLine;
 import org.chromium.base.CommandLineInitUtil;
 import org.chromium.base.ContextUtils;
 import org.chromium.base.EarlyTraceEvent;
@@ -224,6 +225,10 @@ public class SplitCompatApplication extends Application {
             // (see ChildProcessService.java).
             CommandLineInitUtil.initCommandLine(
                     COMMAND_LINE_FILE, SplitCompatApplication::shouldUseDebugFlags);
+            // Switches must be on the command line before the feature list is created in
+            // performBrowserProcessPreloading(); appending them from Application.onCreate runs
+            // too late and the values are silently ignored.
+            applyStartupSwitches();
             PathUtils.setPrivateDataDirectorySuffix(PRIVATE_DATA_DIRECTORY_SUFFIX);
             // Register for activity lifecycle callbacks. Must be done before any activities are
             // created and is needed only by processes that use the ApplicationStatus api (which
@@ -386,4 +391,36 @@ public class SplitCompatApplication extends Application {
             throw new RuntimeException("App out of date, getResources() null, closing app.");
         }
     }
+
+    /**
+     * Appends the startup switches and reads the optional switch file. The switch file is a
+     * debugging aid: /data/local/tmp/browser-switches, one switch per line, so the GPU stack can
+     * be exercised without rebuilding. Nothing GPU related is forced by default: the stock
+     * configuration is the one that starts on real devices.
+     */
+    private static void applyStartupSwitches() {
+        try {
+            CommandLine commandLine = CommandLine.getInstance();
+            commandLine.appendSwitch("disable-fre");
+            commandLine.appendSwitchWithValue("enable-logging", "stderr");
+            commandLine.appendSwitchWithValue("v", "1");
+            commandLine.appendSwitchWithValue("vmodule", "*gpu*=3,*gl*=2,*angle*=2,*child_process*=2");
+            java.io.File extra = new java.io.File("/data/local/tmp/browser-switches");
+            if (extra.isFile()) {
+                for (String line : java.nio.file.Files.readAllLines(extra.toPath())) {
+                    line = line.trim();
+                    if (line.isEmpty() || line.startsWith("#")) continue;
+                    int split = line.indexOf('=');
+                    if (split > 2) {
+                        commandLine.appendSwitchWithValue(
+                                line.substring(2, split), line.substring(split + 1));
+                    } else if (line.startsWith("--")) {
+                        commandLine.appendSwitch(line.substring(2));
+                    }
+                }
+            }
+        } catch (Throwable ignored) {
+            // Never break startup.
+        }
+    }
 }
