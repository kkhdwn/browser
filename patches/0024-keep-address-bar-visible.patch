 /**
@@ -49,6 +59,45 @@ public class TabStateBrowserControlsVisibilityDelegate extends BrowserControlsVi
 
     /** The maximum amount of time to wait for a page to load before entering fullscreen. */
     private static final long MAX_FULLSCREEN_LOAD_DELAY_MS = 3000;
+    /** Mirrors the switch in AddressBarSettingsFragment. */
+    private static final String PREF_ADDRESS_BAR_ALWAYS_VISIBLE = "address_bar_always_visible";
+    private static final String ACTION_ADDRESS_BAR_VISIBILITY_CHANGED =
+            "com.kkhdwn.browser.ADDRESS_BAR_VISIBILITY_CHANGED";
+
+    private static final List<WeakReference<TabStateBrowserControlsVisibilityDelegate>>
+            sInstances = new ArrayList<>();
+    private static BroadcastReceiver sVisibilityReceiver;
+    private static boolean sVisibilityReceiverRegistered;
+
+    /** Re-evaluates the controls constraints for every live tab. */
+    private static void refreshAll() {
+        for (WeakReference<TabStateBrowserControlsVisibilityDelegate> reference : sInstances) {
+            TabStateBrowserControlsVisibilityDelegate delegate = reference.get();
+            if (delegate != null) delegate.updateVisibilityConstraints();
+        }
+        sInstances.removeIf(reference -> reference.get() == null);
+    }
+
+    private static void ensureVisibilityReceiver() {
+        if (sVisibilityReceiverRegistered) return;
+        try {
+            sVisibilityReceiver =
+                    new BroadcastReceiver() {
+                        @Override
+                        public void onReceive(Context context, Intent intent) {
+                            refreshAll();
+                        }
+                    };
+            ContextCompat.registerReceiver(
+                    ContextUtils.getApplicationContext(),
+                    sVisibilityReceiver,
+                    new IntentFilter(ACTION_ADDRESS_BAR_VISIBILITY_CHANGED),
+                    ContextCompat.RECEIVER_NOT_EXPORTED);
+            sVisibilityReceiverRegistered = true;
+        } catch (Throwable ignored) {
+            // The switch still persists; constraints are refreshed on the next tab event.
+        }
+    }
 
     // These values are persisted to logs. Entries should not be renumbered and
     // numeric values should never be reused.
