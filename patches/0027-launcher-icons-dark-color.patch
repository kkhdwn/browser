From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Add the dark and color launcher icons

---
diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index 6ed7920..67240cc 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -141,6 +141,17 @@ if (_is_default_toolchain) {
       "java/res_base/font/chrome_google_sans_text.xml",
       "java/res_base/font/chrome_google_sans_text_medium.xml",
       "java/res_base/values/values.xml",
+      "java/res_base/mipmap-mdpi/ic_launcher_dark.png",
+      "java/res_base/mipmap-xxhdpi/ic_launcher_dark.png",
+      "java/res_base/mipmap-xxxhdpi/ic_launcher_dark.png",
+      "java/res_base/mipmap-xhdpi/ic_launcher_dark.png",
+      "java/res_base/mipmap-hdpi/ic_launcher_dark.png",
+      "java/res_base/mipmap-mdpi/ic_launcher_color.png",
+      "java/res_base/mipmap-xxhdpi/ic_launcher_color.png",
+      "java/res_base/mipmap-xxxhdpi/ic_launcher_color.png",
+      "java/res_base/mipmap-xhdpi/ic_launcher_color.png",
+      "java/res_base/mipmap-hdpi/ic_launcher_color.png",
+
       "java/res_base/xml/network_security_config.xml",
       "java/res_chromium_base/drawable/themed_app_icon.xml",
       "java/res_chromium_base/mipmap-hdpi/app_icon.png",
diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
index 4f8d014..8a0e156 100644
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -221,7 +221,7 @@ by a child template that "extends" this file.
       <application android:name="{% block application_name %}org.chromium.chrome.browser.base.SplitChromeApplication{% endblock %}"
         android:icon="@drawable/ic_launcher"
         android:roundIcon="@drawable/ic_launcher_round"
-        android:label="{% block application_label %}@string/app_name{% endblock %}"
+        android:label="{% block application_label %}Browser{% endblock %}"
         android:memtagMode="async"
         android:largeHeap="false"
         android:manageSpaceActivity="@string/manage_space_activity"
@@ -669,6 +669,29 @@ by a child template that "extends" this file.
             <property android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                 android:value="true" />
         </activity>
+        <!-- Launcher icon styles. Exactly one alias is enabled at a time. -->
+        <activity-alias android:name="com.google.android.apps.chrome.Main.dark"
+            android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
+            android:exported="true"
+            android:enabled="true"
+            android:icon="@mipmap/ic_launcher_dark"
+            android:roundIcon="@mipmap/ic_launcher_dark">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity-alias>
+        <activity-alias android:name="com.google.android.apps.chrome.Main.color"
+            android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
+            android:exported="true"
+            android:enabled="false"
+            android:icon="@mipmap/ic_launcher_color"
+            android:roundIcon="@mipmap/ic_launcher_color">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity-alias>
         <activity-alias android:name="com.google.android.apps.chrome.Main"
             android:targetActivity="org.chromium.chrome.browser.ChromeTabbedActivity"
             android:exported="true">
@@ -677,12 +700,8 @@ by a child template that "extends" this file.
             <intent-filter>
                 <action android:name="android.intent.action.MAIN" />
                 <category android:name="android.intent.category.DEFAULT" />
-                <category android:name="android.intent.category.LAUNCHER" />
                 <category android:name="android.intent.category.BROWSABLE" />
                 <category android:name="android.intent.category.APP_BROWSER" />
-                {% if channel in ['dev', 'canary', 'default'] %}
-                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
-                {% endif %}
             </intent-filter>
             <meta-data android:name="android.app.shortcuts"
                 android:resource="@xml/launchershortcuts" />
diff --git a/chrome/android/java/res/xml/main_preferences.xml b/chrome/android/java/res/xml/main_preferences.xml
index 67228cb..2277a0c 100644
--- a/chrome/android/java/res/xml/main_preferences.xml
+++ b/chrome/android/java/res/xml/main_preferences.xml
@@ -40,6 +40,11 @@ found in the LICENSE file.
         android:key="address_bar"
         android:order="7"
         android:title="@string/address_bar_settings"/>
+    <org.chromium.components.browser_ui.settings.ChromeBasePreference
+        android:fragment="org.chromium.chrome.browser.appicon.AppIconSettingsFragment"
+        android:key="app_icon"
+        android:order="70"
+        android:title="@string/app_icon_settings"/>
     <org.chromium.components.browser_ui.settings.ChromeBasePreference
         android:fragment="org.chromium.chrome.browser.privacy.settings.PrivacySettings"
         android:key="privacy"
diff --git a/chrome/android/java/res_base/mipmap-hdpi/ic_launcher_color.png b/chrome/android/java/res_base/mipmap-hdpi/ic_launcher_color.png
new file mode 100644
