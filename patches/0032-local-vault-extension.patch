+      if (pin.length < MIN_PIN) return {error: 'pin-length'};
+      const salt = toBase64(crypto.getRandomValues(new Uint8Array(16)));
+      const key = await deriveKey(pin, salt);
+      const next = [];
+      for (const item of items) {
+        next.push({
+          id: item.id,
+          origin: item.origin,
+          u: await seal(key, await open(current, item.u)),
+          p: await seal(key, await open(current, item.p)),
+        });
+      }
+      await writeItems(next);
+      await chrome.storage.local.set({
+        [SETTINGS_KEY]: {mode: 'pin', salt, probe: await seal(key, PROBE)},
+      });
+      unlockedKey = key;
+      await writeSession(toBase64(await crypto.subtle.exportKey('raw', key)));
+      return {ok: true};
+    }
+
+    default:
+      return {error: 'unknown'};
+  }
+}
+
+chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
