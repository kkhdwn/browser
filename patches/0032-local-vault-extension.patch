+      if (!message.origin || !message.password) return {error: 'empty'};
+      const items = await readItems();
+      const sealedItem = {
+        id: crypto.randomUUID(),
+        origin: message.origin,
+        u: await seal(unlockedKey, message.username || ''),
+        p: await seal(unlockedKey, message.password),
+      };
+      let replaced = false;
+      for (let i = 0; i < items.length; i++) {
+        if (items[i].origin !== message.origin) continue;
+        let storedUser = '';
+        try {
+          storedUser = await open(unlockedKey, items[i].u);
+        } catch (e) {
+          continue;
+        }
+        if (storedUser === (message.username || '')) {
+          items[i] = {...sealedItem, id: items[i].id};
+          replaced = true;
+          break;
+        }
+      }
+      if (!replaced) items.push(sealedItem);
+      await writeItems(items);
+      return {ok: true};
+    }
+
+    case 'setMode': {
+      const mode = message.mode === 'pin' ? 'pin' : 'none';
+      const items = await readItems();
+      const current = settings.mode === 'pin' ? unlockedKey : null;
+      if (settings.mode === 'pin' && !current) return {error: 'locked'};
+
+      if (mode === 'none') {
+        const plain = [];
+        for (const item of items) {
+          plain.push({
+            id: item.id,
+            origin: item.origin,
+            u: await seal(null, await open(current, item.u)),
+            p: await seal(null, await open(current, item.p)),
+          });
