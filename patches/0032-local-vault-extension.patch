Subject: [PATCH] Add a device-only password vault as a component extension

The Play services password manager cannot run here: its backend class is
Google-internal and an unbranded build always reports it missing, which leaves
the Autofill and passwords page with a dead row. This ships a component
extension instead: a thin bar under the toolbar offers to save a submitted
login and to fill a stored one, keeps records in chrome.storage.local
(app-private, never synced) and, with a PIN set, encrypts every field with
AES-GCM under a PBKDF2 key derived from the PIN.
---
diff --git a/chrome/browser/extensions/component_loader.cc b/chrome/browser/extensions/component_loader.cc
--- a/chrome/browser/extensions/component_loader.cc
+++ b/chrome/browser/extensions/component_loader.cc
@@ -110,6 +110,23 @@ BASE_FEATURE(kRemoveHangoutsExtension, base::FEATURE_DISABLED_BY_DEFAULT);
 
 bool g_enable_background_extensions_during_testing = false;
 
+// Local vault: a device-only password manager. It ships as a component
+// extension because the Play services password manager cannot exist in an
+// unbranded build, and a page-level vault needs no privileged API.
+constexpr char kLocalVaultManifest[] = R"json({
+  "manifest_version": 3,
+  "name": "Local vault",
+  "version": "1.0",
+  "description": "Saves passwords on this device only. Nothing is synced.",
+  "key": "",
+  "permissions": ["storage"],
+  "content_scripts": [{
+    "matches": ["<all_urls>"],
+    "js": ["content.js"],
+    "run_at": "document_idle"
+  }]
+})json";
+
 #if BUILDFLAG(IS_CHROMEOS) && BUILDFLAG(GOOGLE_CHROME_BRANDING)
 // Whether HelpApp is enabled.
 bool g_enable_help_app = true;
@@ -690,6 +707,12 @@ void ComponentLoader::AddDefaultComponentExtensions(
 
   if (!skip_session_components) {
     AddWebStoreApp();
+    const ExtensionId vault_id =
+        Add(kLocalVaultManifest, base::FilePath(FILE_PATH_LITERAL("local_vault")),
+            /*skip_allowlist=*/true);
+    // Visible in logcat with --enable-logging: empty means the manifest or the
+    // allowlist was rejected, and the reason is logged by ComponentLoader.
+    LOG(WARNING) << "local_vault: component extension id=" << vault_id;
 #if BUILDFLAG(IS_CHROMEOS)
     AddChromeApp();
 #endif  // BUILDFLAG(IS_CHROMEOS)
diff --git a/chrome/browser/resources/component_extension_resources.grd b/chrome/browser/resources/component_extension_resources.grd
--- a/chrome/browser/resources/component_extension_resources.grd
+++ b/chrome/browser/resources/component_extension_resources.grd
@@ -12,6 +12,7 @@
   </outputs>
   <release seq="1">
     <includes>
+      <include name="IDR_LOCAL_VAULT_CONTENT_JS" file="local_vault/content.js" type="BINDATA" />
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_JS" file="network_speech_synthesis/tts_extension.js" type="BINDATA" />
 
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_MV3_AUDIO_HTML" file="network_speech_synthesis/mv3/audio.html" type="BINDATA" />
diff --git a/chrome/browser/resources/local_vault/content.js b/chrome/browser/resources/local_vault/content.js
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/local_vault/content.js
@@ -0,0 +1,758 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Device-only password vault. A small key chip sits next to a login field and
+// opens a sheet with the accounts saved for this origin, the option to save a
+// submitted login, and a manager. Records live in chrome.storage.local
+// (app-private, never synced); with a PIN set every field is AES-GCM ciphertext
+// under a PBKDF2 key, and the unlocked key only lives in chrome.storage.session
+// (memory). No background worker, no network call anywhere in this file.
+
+(() => {
+  if (window.top !== window) return;
+  const scheme = location.protocol;
+  if (scheme !== 'https:' && scheme !== 'http:') return;
+  if (window.__localVaultInjected) return;
+  window.__localVaultInjected = true;
+
+  const ORIGIN = location.origin;
+  const HOST = location.host;
+  const PENDING_TTL = 120000;
+  const ITERATIONS = 210000;
+  const PROBE = 'local-vault-probe-v1';
+  const MIN_PIN = 4;
+  const SETTINGS_KEY = 'lv_settings';
+  const ITEMS_KEY = 'lv_items';
+  const PENDING_KEY = 'lv_pending';
+  const KEY_STORAGE = 'lv_key';
+
+  const notes = [];
+  const hasStorage = !!(window.chrome && chrome.storage && chrome.storage.local);
+  const hasSession = !!(window.chrome && chrome.storage && chrome.storage.session);
+  const hasSubtle = !!(window.crypto && window.crypto.subtle);
+  if (!hasStorage) notes.push('storage=missing');
+  if (!hasSession) notes.push('session=missing');
+  if (!hasSubtle) notes.push('subtle=missing');
+  try {
+    if (hasSession && chrome.storage.session.setAccessLevel) {
+      chrome.storage.session.setAccessLevel({accessLevel: 'TRUSTED_AND_UNTRUSTED_CONTEXTS'});
+    }
+  } catch (e) {
+    notes.push('session-level=failed');
+  }
+
+  const root = document.documentElement;
+  function mark(name, value) {
+    root.setAttribute(name, value);
+  }
+  mark('data-local-vault', notes.length ? 'injected(' + notes.join(',') + ')' : 'injected');
+  mark('data-lv-sheet', 'closed');
+  mark('data-lv-chip', 'hidden');
+
+  let unlockedKey = null;
+  let host = null;
+  let shadow = null;
+  let chip = null;
+  let sheet = null;
+  let activeField = null;
+  let currentView = 'accounts';
+
+  const encoder = new TextEncoder();
+  const decoder = new TextDecoder();
+
+  function toBase64(bytes) {
+    let binary = '';
+    const view = new Uint8Array(bytes);
+    for (let i = 0; i < view.length; i++) binary += String.fromCharCode(view[i]);
+    return btoa(binary);
+  }
+
+  function fromBase64(text) {
+    const binary = atob(text);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+    return bytes;
+  }
+
+  function storeGet(keys) {
+    if (!hasStorage) return Promise.resolve({});
+    return new Promise((resolve) => {
+      try {
+        chrome.storage.local.get(keys, (values) => {
+          void chrome.runtime.lastError;
+          resolve(values || {});
+        });
+      } catch (e) {
+        resolve({});
+      }
+    });
+  }
+
+  function storeSet(values) {
+    if (!hasStorage) return Promise.resolve(false);
+    return new Promise((resolve) => {
+      try {
+        chrome.storage.local.set(values, () => {
+          void chrome.runtime.lastError;
+          resolve(true);
+        });
+      } catch (e) {
+        resolve(false);
+      }
+    });
+  }
+
+  function sessionGet(key) {
+    if (!hasSession) return Promise.resolve(null);
+    return new Promise((resolve) => {
+      try {
+        chrome.storage.session.get(key, (values) => {
+          void chrome.runtime.lastError;
+          resolve((values || {})[key] || null);
+        });
+      } catch (e) {
+        resolve(null);
+      }
+    });
+  }
+
+  function sessionSet(key, value) {
+    if (!hasSession) return Promise.resolve();
+    return new Promise((resolve) => {
+      try {
+        if (value === null) {
+          chrome.storage.session.remove(key, () => {
+            void chrome.runtime.lastError;
+            resolve();
+          });
+        } else {
+          chrome.storage.session.set({[key]: value}, () => {
+            void chrome.runtime.lastError;
+            resolve();
+          });
+        }
+      } catch (e) {
+        resolve();
+      }
+    });
+  }
+
+  async function config() {
+    const stored = await storeGet(SETTINGS_KEY);
+    return stored[SETTINGS_KEY] || {mode: 'none'};
+  }
+
+  async function allItems() {
+    const stored = await storeGet(ITEMS_KEY);
+    return stored[ITEMS_KEY] || [];
+  }
+
+  async function originItems() {
+    return (await allItems()).filter((item) => item.origin === ORIGIN);
+  }
+
+  async function deriveKey(pin, salt) {
+    const material = await crypto.subtle.importKey(
+        'raw', encoder.encode(pin), 'PBKDF2', false, ['deriveKey']);
+    return crypto.subtle.deriveKey(
+        {name: 'PBKDF2', salt: fromBase64(salt), iterations: ITERATIONS, hash: 'SHA-256'},
+        material, {name: 'AES-GCM', length: 256}, true, ['encrypt', 'decrypt']);
+  }
+
+  async function seal(key, text) {
+    if (!key) return {iv: '', ct: toBase64(encoder.encode(text))};
+    const iv = crypto.getRandomValues(new Uint8Array(12));
+    const cipher = await crypto.subtle.encrypt({name: 'AES-GCM', iv}, key, encoder.encode(text));
+    return {iv: toBase64(iv), ct: toBase64(cipher)};
+  }
+
+  async function open(key, blob) {
+    if (!blob) return '';
+    if (!blob.iv) return decoder.decode(fromBase64(blob.ct));
+    if (!hasSubtle) throw new Error('no-subtle');
+    const plain = await crypto.subtle.decrypt(
+        {name: 'AES-GCM', iv: fromBase64(blob.iv)}, key, fromBase64(blob.ct));
+    return decoder.decode(plain);
+  }
+
+  async function restoreKey(settings) {
+    if (settings.mode !== 'pin') {
+      unlockedKey = null;
+      return null;
+    }
+    if (unlockedKey) return unlockedKey;
+    const raw = await sessionGet(KEY_STORAGE);
+    if (!raw) return null;
+    try {
+      unlockedKey = await crypto.subtle.importKey(
+          'raw', fromBase64(raw), {name: 'AES-GCM'}, true, ['encrypt', 'decrypt']);
+    } catch (e) {
+      unlockedKey = null;
+    }
+    return unlockedKey;
+  }
+
+  async function unlock(settings, pin) {
+    if (!pin || !settings.salt || !hasSubtle) return false;
+    const key = await deriveKey(pin, settings.salt);
+    try {
+      if (await open(key, settings.probe) !== PROBE) return false;
+    } catch (e) {
+      return false;
+    }
+    unlockedKey = key;
+    await sessionSet(KEY_STORAGE, toBase64(await crypto.subtle.exportKey('raw', key)));
+    return true;
+  }
+
+  const STYLE = `
+    :host { all: initial; }
+    .chip {
+      position: fixed; width: 34px; height: 34px; border-radius: 17px;
+      display: flex; align-items: center; justify-content: center;
+      background: #202124; color: #8ab4f8; border: 1px solid #3c4043;
+      font: 16px/1 Roboto, system-ui, sans-serif; pointer-events: auto;
+      box-shadow: 0 2px 6px rgba(0,0,0,.45); cursor: pointer;
+    }
+    .badge {
+      position: absolute; top: -4px; right: -4px; min-width: 16px; height: 16px;
+      border-radius: 8px; background: #8ab4f8; color: #202124;
+      font: 600 10px/16px Roboto, system-ui, sans-serif; text-align: center;
+    }
+    .scrim { position: fixed; inset: 0; background: rgba(0,0,0,.45); pointer-events: auto; }
+    .sheet {
+      position: fixed; left: 0; right: 0; bottom: 0; pointer-events: auto;
+      background: #292a2d; color: #e8eaed; border-radius: 16px 16px 0 0;
+      box-shadow: 0 -2px 12px rgba(0,0,0,.5);
+      font: 14px/20px Roboto, system-ui, sans-serif;
+      max-height: 70vh; display: flex; flex-direction: column;
+    }
+    .head { padding: 14px 16px 6px; }
+    .title { font-size: 16px; font-weight: 500; }
+    .sub { color: #9aa0a6; font-size: 12px; }
+    .body { overflow-y: auto; padding: 0 8px 8px; }
+    .row {
+      display: flex; align-items: center; gap: 10px; padding: 12px 10px;
+      border-radius: 10px; cursor: pointer;
+    }
+    .row:hover { background: #35363a; }
+    .row .who { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+    .avatar {
+      width: 30px; height: 30px; border-radius: 15px; background: #3c4043;
+      color: #8ab4f8; font: 600 14px/30px Roboto, system-ui, sans-serif; text-align: center;
+    }
+    button {
+      all: unset; cursor: pointer; padding: 8px 12px; border-radius: 18px;
+      font: 500 13px/18px Roboto, system-ui, sans-serif; color: #8ab4f8;
+    }
+    button.solid { background: #8ab4f8; color: #202124; }
+    button.danger { color: #f28b82; }
+    input {
+      all: unset; background: #1f2023; color: #e8eaed; border-radius: 8px;
+      padding: 9px 10px; font: 14px Roboto, system-ui, sans-serif; width: 100%;
+      box-sizing: border-box; margin: 4px 0;
+    }
+    .field { padding: 4px 16px 8px; }
+    .actions { display: flex; gap: 8px; justify-content: flex-end; padding: 4px 12px 12px; }
+    .divider { height: 1px; background: #3c4043; margin: 8px 16px; }
+    label.opt { display: flex; align-items: center; gap: 8px; padding: 8px 16px; cursor: pointer; }
+    .hint { color: #9aa0a6; font-size: 11px; padding: 0 16px 8px; }
+  `;
+
+  function el(tag, props, ...children) {
+    const node = document.createElement(tag);
+    Object.assign(node, props || {});
+    for (const child of children) node.append(child);
+    return node;
+  }
+
+  function build() {
+    if (host) return;
+    host = document.createElement('div');
+    host.id = 'local-vault-root';
+    host.style.cssText =
+        'position:fixed;inset:0;z-index:2147483647;pointer-events:none;';
+    shadow = host.attachShadow({mode: 'open'});
+    const style = document.createElement('style');
+    style.textContent = STYLE;
+    shadow.appendChild(style);
+    (document.body || document.documentElement).appendChild(host);
+  }
+
+  // ---------------------------------------------------------------- geometry
+
+  function visualBottomInset() {
+    const vv = window.visualViewport;
+    if (!vv) return 0;
+    return Math.max(0, window.innerHeight - (vv.offsetTop + vv.height));
+  }
+
+  function placeChip(field) {
+    if (!chip || !field) return;
+    const rect = field.getBoundingClientRect();
+    const top = Math.min(Math.max(rect.top + (rect.height - 34) / 2, 4), window.innerHeight - 42);
+    chip.style.top = top + 'px';
+    chip.style.left = Math.max(rect.right - 42, 4) + 'px';
+  }
+
+  function keepPosition() {
+    if (activeField && chip && chip.style.display !== 'none') placeChip(activeField);
+    if (sheet && sheet.parentNode) sheet.style.bottom = visualBottomInset() + 'px';
+  }
+
+  window.addEventListener('scroll', keepPosition, {passive: true});
+  window.addEventListener('resize', keepPosition);
+  if (window.visualViewport) {
+    window.visualViewport.addEventListener('resize', keepPosition);
+    window.visualViewport.addEventListener('scroll', keepPosition);
+  }
+
+  // -------------------------------------------------------------------- chip
+
+  function showChip(field, count) {
+    build();
+    activeField = field || activeField;
+    if (!chip) {
+      chip = el('div', {className: 'chip'});
+      chip.append(document.createTextNode('\u26BF'));
+      chip.addEventListener('mousedown', (event) => {
+        event.preventDefault();
+        event.stopPropagation();
+        openAccounts();
+      }, true);
+      chip.addEventListener('click', (event) => {
+        event.preventDefault();
+        event.stopPropagation();
+      }, true);
+      shadow.appendChild(chip);
+    }
+    const badge = chip.querySelector('.badge');
+    if (badge) badge.remove();
+    if (count > 0) {
+      chip.append(el('span', {className: 'badge'}, document.createTextNode(String(count))));
+    }
+    if (activeField) placeChip(activeField);
+    chip.style.display = 'flex';
+    mark('data-lv-chip', 'shown');
+  }
+
+  function hideChip() {
+    if (chip) chip.style.display = 'none';
+    mark('data-lv-chip', 'hidden');
+  }
+
+  // ------------------------------------------------------------------- sheet
+
+  function closeSheet() {
+    if (sheet) {
+      sheet.remove();
+      sheet = null;
+    }
+    const scrim = shadow && shadow.querySelector('.scrim');
+    if (scrim) scrim.remove();
+    mark('data-lv-sheet', 'closed');
+  }
+
+  function openSheet(build) {
+    build_impl(build);
+  }
+
+  function build_impl(render) {
+    build();
+    closeSheet();
+    const scrim = el('div', {className: 'scrim'});
+    scrim.addEventListener('click', closeSheet);
+    shadow.appendChild(scrim);
+    sheet = el('div', {className: 'sheet'});
+    sheet.style.bottom = visualBottomInset() + 'px';
+    shadow.appendChild(sheet);
+    render(sheet);
+    mark('data-lv-sheet', 'open');
+  }
+
+  function head(title, subtitle) {
+    return el('div', {className: 'head'},
+        el('div', {className: 'title'}, document.createTextNode(title)),
+        subtitle ? el('div', {className: 'sub'}, document.createTextNode(subtitle)) : document.createTextNode(''));
+  }
+
+  function button(text, cls, onclick) {
+    return el('button', {className: cls || '', textContent: text, onclick});
+  }
+
+  async function openAccounts() {
+    const settings = await config();
+    const key = await restoreKey(settings);
+    if (settings.mode === 'pin' && !key) {
+      openPinSheet('Masukkan PIN', openAccounts);
+      return;
+    }
+    const list = await originItems();
+    const rows = [];
+    for (const item of list) {
+      let who = '';
+      try {
+        who = await open(key, item.u);
+      } catch (e) {
+        who = '(tidak terbaca)';
+      }
+      const initial = (who || HOST).slice(0, 1).toUpperCase();
+      rows.push(el('div', {
+        className: 'row',
+        onclick: () => fillAccount(item),
+      }, el('div', {className: 'avatar'}, document.createTextNode(initial)),
+         el('div', {className: 'who'}, document.createTextNode(who || '(tanpa nama)'))));
+    }
+    if (!rows.length) {
+      rows.push(el('div', {className: 'row'},
+          el('div', {className: 'who'}, document.createTextNode('Belum ada akun untuk ' + HOST))));
+    }
+    openSheet((node) => {
+      node.append(head('Kata sandi', HOST));
+      const body = el('div', {className: 'body'}, ...rows);
+      node.append(body);
+      node.append(el('div', {className: 'actions'},
+          button('Kelola', '', () => openManager()),
+          button('Tutup', '', closeSheet)));
+    });
+  }
+
+  function openPinSheet(title, next) {
+    openSheet((node) => {
+      node.append(head(title, 'Vault terkunci'));
+      const input = el('input', {type: 'password', placeholder: 'PIN', maxLength: 32});
+      const status = el('div', {className: 'hint'});
+      const submit = async () => {
+        const settings = await config();
+        if (await unlock(settings, input.value)) {
+          next();
+        } else {
+          status.textContent = 'PIN salah';
+        }
+      };
+      input.addEventListener('keydown', (event) => {
+        if (event.key === 'Enter') submit();
+      });
+      node.append(el('div', {className: 'field'}, input));
+      node.append(el('div', {className: 'hint'}, document.createTextNode('PIN tidak disimpan; hanya menurunkan kunci AES.')));
+      node.append(el('div', {className: 'actions'},
+          button('Batal', '', closeSheet),
+          button('Buka', 'solid', submit)));
+      node.append(status);
+      setTimeout(() => input.focus(), 50);
+    });
+  }
+
+  async function fillAccount(item) {
+    const settings = await config();
+    const key = await restoreKey(settings);
+    if (settings.mode === 'pin' && !key) {
+      openPinSheet('Masukkan PIN', () => fillAccount(item));
+      return;
+    }
+    const field = activeField && document.contains(activeField) ?
+        activeField : passwordFields(document)[0];
+    if (!field) {
+      closeSheet();
+      return;
+    }
+    try {
+      const user = await open(key, item.u);
+      const pass = await open(key, item.p);
+      const userField = usernameField(field.closest('form') || document, field);
+      if (userField) setValue(userField, user);
+      setValue(field, pass);
+    } catch (e) {
+      openPinSheet('Masukkan PIN', () => fillAccount(item));
+      return;
+    }
+    closeSheet();
+  }
+
+  // ----------------------------------------------------------------- manager
+
+  async function openManager() {
+    const settings = await config();
+    const key = await restoreKey(settings);
+    const list = await allItems();
+    const rows = [];
+    for (const item of list) {
+      let who = '';
+      try {
+        who = await open(key, item.u);
+      } catch (e) {
+        who = '(terkunci)';
+      }
+      const remove = button('Hapus', 'danger', async () => {
+        const next = (await allItems()).filter((candidate) => candidate.id !== item.id);
+        await storeSet({[ITEMS_KEY]: next});
+        openManager();
+      });
+      rows.push(el('div', {className: 'row'},
+          el('div', {className: 'who'},
+              document.createTextNode((who || '(tanpa nama)') + ' \u00b7 ' + item.origin)),
+          remove));
+    }
+    if (!rows.length) {
+      rows.push(el('div', {className: 'row'},
+          el('div', {className: 'who'}, document.createTextNode('Belum ada akun tersimpan'))));
+    }
+
+    const userInput = el('input', {type: 'text', placeholder: 'Username / email', maxLength: 128});
+    const passInput = el('input', {type: 'password', placeholder: 'Kata sandi', maxLength: 128});
+    const pin1 = el('input', {type: 'password', placeholder: 'PIN baru', maxLength: 32});
+    const pin2 = el('input', {type: 'password', placeholder: 'Ulangi PIN', maxLength: 32});
+    const status = el('div', {className: 'hint'});
+
+    const add = button('Tambah untuk situs ini', '', async () => {
+      if (!passInput.value) {
+        status.textContent = 'Kata sandi kosong.';
+        return;
+      }
+      const current = await config();
+      const currentKey = await restoreKey(current);
+      if (current.mode === 'pin' && !currentKey) {
+        openPinSheet('Masukkan PIN', openManager);
+        return;
+      }
+      const items = await allItems();
+      items.push({
+        id: (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random()),
+        origin: ORIGIN,
+        u: await seal(currentKey, userInput.value),
+        p: await seal(currentKey, passInput.value),
+      });
+      await storeSet({[ITEMS_KEY]: items});
+      openManager();
+    });
+
+    const applyLock = button('Simpan kunci', 'solid', async () => {
+      const current = await config();
+      const currentKey = current.mode === 'pin' ? await restoreKey(current) : null;
+      if (current.mode === 'pin' && !currentKey) {
+        openPinSheet('Masukkan PIN', openManager);
+        return;
+      }
+      const wantPin = pin1.value.length > 0 || pin2.value.length > 0;
+      if (!wantPin) {
+        const items = await allItems();
+        const plain = [];
+        for (const item of items) {
+          plain.push({
+            id: item.id, origin: item.origin,
+            u: await seal(null, await open(currentKey, item.u)),
+            p: await seal(null, await open(currentKey, item.p)),
+          });
+        }
+        await storeSet({[ITEMS_KEY]: plain, [SETTINGS_KEY]: {mode: 'none'}});
+        unlockedKey = null;
+        await sessionSet(KEY_STORAGE, null);
+        status.textContent = 'Kunci PIN dimatikan.';
+        return;
+      }
+      if (!hasSubtle) {
+        status.textContent = 'PIN butuh halaman https.';
+        return;
+      }
+      if (pin1.value.length < MIN_PIN) {
+        status.textContent = 'PIN minimal ' + MIN_PIN + ' karakter.';
+        return;
+      }
+      if (pin1.value !== pin2.value) {
+        status.textContent = 'PIN tidak sama.';
+        return;
+      }
+      const salt = toBase64(crypto.getRandomValues(new Uint8Array(16)));
+      const next = await deriveKey(pin1.value, salt);
+      const items = await allItems();
+      const sealed = [];
+      for (const item of items) {
+        sealed.push({
+          id: item.id, origin: item.origin,
+          u: await seal(next, await open(currentKey, item.u)),
+          p: await seal(next, await open(currentKey, item.p)),
+        });
+      }
+      await storeSet({
+        [ITEMS_KEY]: sealed,
+        [SETTINGS_KEY]: {mode: 'pin', salt, probe: await seal(next, PROBE)},
+      });
+      unlockedKey = next;
+      await sessionSet(KEY_STORAGE, toBase64(await crypto.subtle.exportKey('raw', next)));
+      status.textContent = 'PIN aktif.';
+    });
+
+    openSheet((node) => {
+      node.append(head('Kelola kata sandi', settings.mode === 'pin' ? 'Terkunci PIN' : 'Tanpa PIN'));
+      const body = el('div', {className: 'body'}, ...rows);
+      node.append(body);
+      node.append(el('div', {className: 'divider'}));
+      node.append(el('div', {className: 'field'},
+          document.createTextNode('Tambah akun untuk ' + HOST),
+          userInput, passInput, add));
+      node.append(el('div', {className: 'divider'}));
+      node.append(el('div', {className: 'field'},
+          document.createTextNode('Kunci vault dengan PIN'), pin1, pin2, applyLock));
+      node.append(el('div', {className: 'hint'},
+          document.createTextNode('Kosongkan PIN untuk membuka tanpa kunci.')));
+      node.append(status);
+      node.append(el('div', {className: 'actions'}, button('Tutup', '', closeSheet)));
+    });
+  }
+
+  // -------------------------------------------------------------------- save
+
+  async function savePending(pending) {
+    const settings = await config();
+    const key = await restoreKey(settings);
+    if (settings.mode === 'pin' && !key) {
+      openPinSheet('Masukkan PIN untuk menyimpan', () => savePending(pending));
+      return;
+    }
+    const items = await allItems();
+    let replaced = false;
+    for (const item of items) {
+      if (item.origin !== pending.origin) continue;
+      let stored = '';
+      try {
+        stored = await open(key, item.u);
+      } catch (e) {
+        continue;
+      }
+      if (stored === pending.username) {
+        item.u = await seal(key, pending.username);
+        item.p = await seal(key, pending.password);
+        replaced = true;
+        break;
+      }
+    }
+    if (!replaced) {
+      items.push({
+        id: (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random()),
+        origin: pending.origin,
+        u: await seal(key, pending.username),
+        p: await seal(key, pending.password),
+      });
+    }
+    await storeSet({[ITEMS_KEY]: items, [PENDING_KEY]: null});
+    closeSheet();
+    const list = await originItems();
+    showChip(passwordFields(document)[0] || activeField, list.length);
+  }
+
+  function openSaveSheet(pending) {
+    openSheet((node) => {
+      node.append(head('Simpan kata sandi?', HOST));
+      const body = el('div', {className: 'body'});
+      body.append(el('div', {className: 'row'},
+          el('div', {className: 'avatar'},
+              document.createTextNode((pending.username || HOST).slice(0, 1).toUpperCase())),
+          el('div', {className: 'who'},
+              document.createTextNode(pending.username || '(tanpa username)'))));
+      node.append(body);
+      node.append(el('div', {className: 'actions'},
+          button('Bukan sekarang', '', async () => {
+            await storeSet({[PENDING_KEY]: null});
+            closeSheet();
+          }),
+          button('Simpan', 'solid', () => savePending(pending))));
+    });
+  }
+
+  // --------------------------------------------------------------- page glue
+
+  function passwordFields(scope) {
+    return Array.from(scope.querySelectorAll('input[type="password"]'))
+        .filter((input) => !input.disabled);
+  }
+
+  function usernameField(scope, password) {
+    const inputs = Array.from(scope.querySelectorAll(
+        'input:not([type]), input[type="text"], input[type="email"], input[type="tel"]'));
+    let best = null;
+    for (const input of inputs) {
+      if (input.disabled) continue;
+      if (input.compareDocumentPosition(password) & Node.DOCUMENT_POSITION_FOLLOWING) best = input;
+    }
+    const named = scope.querySelector('input[autocomplete*="username"]');
+    if (named && !named.disabled) return named;
+    return best;
+  }
+
+  function credentialsFrom(node) {
+    const form = node && node.closest ? node.closest('form') : null;
+    const scope = form || document;
+    const password = passwordFields(scope)[0];
+    if (!password || !password.value) return null;
+    const username = usernameField(scope, password);
+    return {username: username ? username.value.trim() : '', password: password.value};
+  }
+
+  function setValue(input, value) {
+    const proto = input instanceof HTMLTextAreaElement ?
+        HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
+    const setter = Object.getOwnPropertyDescriptor(proto, 'value');
+    if (setter && setter.set) {
+      setter.set.call(input, value);
+    } else {
+      input.value = value;
+    }
+    input.dispatchEvent(new Event('input', {bubbles: true}));
+    input.dispatchEvent(new Event('change', {bubbles: true}));
+  }
+
+  function capture(node) {
+    const creds = credentialsFrom(node);
+    if (!creds) return;
+    storeSet({[PENDING_KEY]: {
+      origin: ORIGIN,
+      username: creds.username,
+      password: creds.password,
+      ts: Date.now(),
+    }});
+  }
+
+  document.addEventListener('focusin', async (event) => {
+    const target = event.target;
+    if (!target || target.type !== 'password') return;
+    const list = await originItems();
+    showChip(target, list.length);
+  }, true);
+
+  document.addEventListener('focusout', () => {
+    setTimeout(() => {
+      const focused = document.activeElement;
+      if (focused && focused.type === 'password') return;
+      if (sheet) return;
+      hideChip();
+    }, 250);
+  }, true);
+
+  document.addEventListener('submit', (event) => capture(event.target), true);
+  document.addEventListener('keydown', (event) => {
+    if (event.key !== 'Enter') return;
+    const target = event.target;
+    if (!target || target.type !== 'password') return;
+    capture(target);
+  }, true);
+
+  async function onLoad() {
+    const stored = await storeGet(PENDING_KEY);
+    const pending = stored[PENDING_KEY];
+    if (pending && pending.origin === ORIGIN && Date.now() - pending.ts < PENDING_TTL) {
+      await storeSet({[PENDING_KEY]: null});
+      openSaveSheet(pending);
+      return;
+    }
+    const list = await originItems();
+    const field = passwordFields(document)[0];
+    if (field && list.length) showChip(field, list.length);
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', onLoad, {once: true});
+  } else {
+    onLoad();
+  }
+})();
