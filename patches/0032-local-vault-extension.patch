Subject: [PATCH] Add a device-only password vault as a component extension

The Play services password manager cannot run here: its backend class is
Google-internal and an unbranded build always reports it missing, which leaves
the Autofill and passwords page with a dead row. This ships a component
extension instead: a thin bar under the toolbar offers to save a submitted
login and to fill a stored one, keeps records in chrome.storage.local
(app-private, never synced) and, with a PIN set, encrypts every field with
AES-GCM under a PBKDF2 key derived from the PIN.
---
diff --git a/chrome/browser/extensions/component_loader.cc b/chrome/browser/extensions/component_loader.cc
--- a/chrome/browser/extensions/component_loader.cc
+++ b/chrome/browser/extensions/component_loader.cc
@@ -110,6 +110,24 @@ BASE_FEATURE(kRemoveHangoutsExtension, base::FEATURE_DISABLED_BY_DEFAULT);
 
 bool g_enable_background_extensions_during_testing = false;
 
+// Local vault: a device-only password manager. It ships as a component
+// extension because the Play services password manager cannot exist in an
+// unbranded build, and a page-level vault needs no privileged API.
+constexpr char kLocalVaultManifest[] = R"json({
+  "manifest_version": 3,
+  "name": "Local vault",
+  "version": "1.0",
+  "description": "Saves passwords on this device only. Nothing is synced.",
+  "key": "",
+  "permissions": ["storage"],
+  "background": {"service_worker": "worker.js"},
+  "content_scripts": [{
+    "matches": ["<all_urls>"],
+    "js": ["content.js"],
+    "run_at": "document_idle"
+  }]
+})json";
+
 #if BUILDFLAG(IS_CHROMEOS) && BUILDFLAG(GOOGLE_CHROME_BRANDING)
 // Whether HelpApp is enabled.
 bool g_enable_help_app = true;
@@ -690,6 +708,8 @@ void ComponentLoader::AddDefaultComponentExtensions(
 
   if (!skip_session_components) {
     AddWebStoreApp();
+    Add(kLocalVaultManifest, base::FilePath(FILE_PATH_LITERAL("local_vault")),
+        /*skip_allowlist=*/true);
 #if BUILDFLAG(IS_CHROMEOS)
     AddChromeApp();
 #endif  // BUILDFLAG(IS_CHROMEOS)
diff --git a/chrome/browser/resources/component_extension_resources.grd b/chrome/browser/resources/component_extension_resources.grd
--- a/chrome/browser/resources/component_extension_resources.grd
+++ b/chrome/browser/resources/component_extension_resources.grd
@@ -12,6 +12,8 @@
   </outputs>
   <release seq="1">
     <includes>
+      <include name="IDR_LOCAL_VAULT_CONTENT_JS" file="local_vault/content.js" type="BINDATA" />
+      <include name="IDR_LOCAL_VAULT_WORKER_JS" file="local_vault/worker.js" type="BINDATA" />
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_JS" file="network_speech_synthesis/tts_extension.js" type="BINDATA" />
 
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_MV3_AUDIO_HTML" file="network_speech_synthesis/mv3/audio.html" type="BINDATA" />
diff --git a/chrome/browser/resources/local_vault/content.js b/chrome/browser/resources/local_vault/content.js
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/local_vault/content.js
@@ -0,0 +1,369 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Device-only password vault: the page half. Renders a thin bar pinned to the
+// top of the viewport, captures submitted logins and fills stored ones. All
+// storage and crypto live in worker.js; this file never persists anything.
+
+(() => {
+  if (window.top !== window) return;
+  const scheme = location.protocol;
+  if (scheme !== 'https:' && scheme !== 'http:') return;
+  if (window.__localVaultInjected) return;
+  window.__localVaultInjected = true;
+
+  const ORIGIN = location.origin;
+  const HOST_ID = 'local-vault-bar';
+  const PENDING_TTL = 120000;
+
+  let host = null;
+  let shadow = null;
+  let root = null;
+  let state = 'hidden';
+
+  function send(message) {
+    return new Promise((resolve) => {
+      try {
+        chrome.runtime.sendMessage(message, (reply) => {
+          void chrome.runtime.lastError;
+          resolve(reply || null);
+        });
+      } catch (e) {
+        resolve(null);
+      }
+    });
+  }
+
+  const STYLE = `
+    :host { all: initial; }
+    .bar {
+      position: fixed; top: 0; left: 0; right: 0;
+      display: flex; align-items: center; gap: 8px;
+      min-height: 40px; padding: 0 12px;
+      box-sizing: border-box;
+      background: #292a2d; color: #e8eaed;
+      font: 13px/18px Roboto, system-ui, sans-serif;
+      box-shadow: 0 1px 4px rgba(0,0,0,.5);
+      z-index: 2147483647;
+    }
+    .text { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+    .sub { color: #9aa0a6; font-size: 11px; display: block; }
+    button {
+      all: unset; cursor: pointer; padding: 6px 10px; border-radius: 16px;
+      font: 500 13px/18px Roboto, system-ui, sans-serif; color: #8ab4f8;
+    }
+    button.solid { background: #8ab4f8; color: #202124; }
+    button.icon { padding: 6px 8px; color: #9aa0a6; }
+    input {
+      all: unset; background: #1f2023; color: #e8eaed; border-radius: 6px;
+      padding: 5px 8px; width: 120px; font: 13px Roboto, system-ui, sans-serif;
+    }
+    .row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+    .list { display: flex; flex-direction: column; gap: 2px; padding: 8px 12px; }
+    .settings { background: #292a2d; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 2px 6px rgba(0,0,0,.5); }
+    label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
+    .hint { color: #9aa0a6; font-size: 11px; }
+  `;
+
+  function build() {
+    if (host) return;
+    host = document.createElement('div');
+    host.id = HOST_ID;
+    host.style.cssText =
+        'position:fixed;top:0;left:0;right:0;z-index:2147483647;';
+    shadow = host.attachShadow({mode: 'open'});
+    const style = document.createElement('style');
+    style.textContent = STYLE;
+    shadow.appendChild(style);
+    root = document.createElement('div');
+    shadow.appendChild(root);
+    (document.body || document.documentElement).appendChild(host);
+  }
+
+  function clear() {
+    while (root.firstChild) root.removeChild(root.firstChild);
+  }
+
+  function el(tag, props, ...children) {
+    const node = document.createElement(tag);
+    Object.assign(node, props || {});
+    for (const child of children) {
+      node.append(child);
+    }
+    return node;
+  }
+
+  function hide() {
+    state = 'hidden';
+    if (host) host.style.display = 'none';
+  }
+
+  function show() {
+    build();
+    host.style.display = 'block';
+  }
+
+  function label(main, sub) {
+    const wrap = el('div', {className: 'text'});
+    wrap.append(document.createTextNode(main));
+    if (sub) wrap.append(el('span', {className: 'sub'}, document.createTextNode(sub)));
+    return wrap;
+  }
+
+  function renderBar(children) {
+    clear();
+    const bar = el('div', {className: 'bar'});
+    for (const child of children) bar.append(child);
+    root.append(bar);
+    show();
+  }
+
+  function renderSettings(settings) {
+    clear();
+    const bar = el('div', {className: 'bar'});
+    bar.append(label('Local vault', 'Device-only password storage'));
+    bar.append(el('button', {
+      className: 'icon',
+      textContent: '\u2715',
+      onclick: () => hide(),
+    }));
+    root.append(bar);
+    const panel = el('div', {className: 'settings'});
+    const none = el('input', {type: 'radio', name: 'lv-mode', value: 'none'});
+    none.checked = settings.mode === 'none';
+    const pin = el('input', {type: 'radio', name: 'lv-mode', value: 'pin'});
+    pin.checked = settings.mode === 'pin';
+    panel.append(el('label', {}, none, document.createTextNode('Open without a PIN')));
+    panel.append(el('label', {}, pin, document.createTextNode('Lock with a PIN')));
+    const pinInput = el('input', {type: 'password', placeholder: 'PIN', maxLength: 32});
+    const pinInput2 = el('input', {type: 'password', placeholder: 'Repeat PIN', maxLength: 32});
+    panel.append(el('div', {className: 'row'}, pinInput, pinInput2));
+    panel.append(el('div', {className: 'hint'},
+        document.createTextNode('PIN is never stored. It derives the key that encrypts the vault.')));
+    const status = el('div', {className: 'hint'});
+    const save = el('button', {className: 'solid', textContent: 'Save settings'});
+    save.onclick = async () => {
+      const mode = pin.checked ? 'pin' : 'none';
+      const next = pinInput.value;
+      if (mode === 'pin' && next.length < 4) {
+        status.textContent = 'PIN must be at least 4 characters.';
+        return;
+      }
+      if (mode === 'pin' && next !== pinInput2.value) {
+        status.textContent = 'PINs do not match.';
+        return;
+      }
+      const reply = await send({type: 'setMode', mode, pin: next});
+      if (reply && reply.ok) {
+        hide();
+        return;
+      }
+      status.textContent = reply && reply.error === 'pin' ? 'Wrong current PIN.' : 'Could not change the lock.';
+    };
+    panel.append(el('div', {className: 'row'}, save, status));
+    root.append(panel);
+    show();
+  }
+
+  function pinPrompt(intro, onSubmit) {
+    clear();
+    const form = el('div', {className: 'bar'});
+    form.append(label(intro, 'Local vault is locked'));
+    const input = el('input', {type: 'password', placeholder: 'PIN', maxLength: 32});
+    const go = el('button', {className: 'solid', textContent: 'Unlock'});
+    const cancel = el('button', {textContent: 'Cancel', onclick: () => hide()});
+    const error = el('span', {className: 'sub'});
+    const submit = async () => {
+      const reply = await send({type: 'unlock', pin: input.value});
+      if (reply && reply.ok) {
+        onSubmit();
+      } else {
+        error.textContent = 'Wrong PIN';
+      }
+    };
+    go.onclick = submit;
+    input.onkeydown = (event) => {
+      if (event.key === 'Enter') submit();
+    };
+    form.append(input, go, cancel, error);
+    root.append(form);
+    show();
+    input.focus();
+  }
+
+  function findLoginForm(node) {
+    if (!node) return null;
+    const form = node.closest ? node.closest('form') : null;
+    if (form) return form;
+    return node.form || null;
+  }
+
+  function passwordFields(scope) {
+    return Array.from(scope.querySelectorAll('input[type="password"]'))
+        .filter((input) => !input.disabled && input.type === 'password');
+  }
+
+  function usernameField(scope, password) {
+    const inputs = Array.from(
+        scope.querySelectorAll('input:not([type]), input[type="text"], input[type="email"], input[type="tel"]'));
+    let best = null;
+    for (const input of inputs) {
+      if (input.disabled) continue;
+      if (input.compareDocumentPosition(password) & Node.DOCUMENT_POSITION_FOLLOWING) {
+        best = input;
+      }
+    }
+    const autocomplete = scope.querySelector('input[autocomplete*="username"]');
+    if (autocomplete && !autocomplete.disabled) return autocomplete;
+    return best;
+  }
+
+  function credentialsFrom(node) {
+    const form = findLoginForm(node);
+    const scope = form || document;
+    const password = passwordFields(scope)[0];
+    if (!password || !password.value) return null;
+    const username = usernameField(scope, password);
+    return {
+      username: username ? username.value.trim() : '',
+      password: password.value,
+    };
+  }
+
+  function setValue(input, value) {
+    const proto = input instanceof HTMLTextAreaElement ?
+        HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
+    const setter = Object.getOwnPropertyDescriptor(proto, 'value');
+    if (setter && setter.set) {
+      setter.set.call(input, value);
+    } else {
+      input.value = value;
+    }
+    input.dispatchEvent(new Event('input', {bubbles: true}));
+    input.dispatchEvent(new Event('change', {bubbles: true}));
+  }
+
+  async function fillWith(id) {
+    const reply = await send({type: 'fill', origin: ORIGIN, id});
+    if (reply && reply.error === 'locked') {
+      pinPrompt('Enter your PIN to fill', () => fillWith(id));
+      return;
+    }
+    if (!reply || !reply.username && !reply.password) {
+      hide();
+      return;
+    }
+    const password = passwordFields(document)[0];
+    if (!password) {
+      hide();
+      return;
+    }
+    const username = usernameField(findLoginForm(password) || document, password);
+    if (username && reply.username) setValue(username, reply.username);
+    if (reply.password) setValue(password, reply.password);
+    hide();
+  }
+
+  async function savePending(pending) {
+    const reply = await send({
+      type: 'save',
+      origin: pending.origin,
+      username: pending.username,
+      password: pending.password,
+    });
+    if (reply && reply.error === 'locked') {
+      pinPrompt('Enter your PIN to save', () => savePending(pending));
+      return;
+    }
+    hide();
+  }
+
+  function renderSave(pending) {
+    const where = pending.username ? pending.username : 'this site';
+    renderBar([
+      label('Save password?', where),
+      el('button', {
+        className: 'solid',
+        textContent: 'Save',
+        onclick: () => savePending(pending),
+      }),
+      el('button', {
+        textContent: 'Not now',
+        onclick: async () => {
+          await send({type: 'dropPending'});
+          hide();
+        },
+      }),
+    ]);
+  }
+
+  function renderFill(items) {
+    const first = items[0];
+    const where = items.length > 1 ? `${items.length} accounts` : (first.username || 'saved account');
+    renderBar([
+      label('Fill password?', where),
+      el('button', {
+        className: 'solid',
+        textContent: 'Fill',
+        onclick: () => fillWith(first.id),
+      }),
+      el('button', {textContent: 'Not now', onclick: () => hide()}),
+      el('button', {
+        className: 'icon',
+        textContent: '\u2699',
+        onclick: async () => {
+          const settings = await send({type: 'getSettings'});
+          renderSettings(settings || {mode: 'none'});
+        },
+      }),
+    ]);
+  }
+
+  async function onLoad() {
+    const pending = await send({type: 'takePending', origin: ORIGIN});
+    if (pending && Date.now() - pending.ts < PENDING_TTL) {
+      renderSave(pending);
+      return;
+    }
+    const list = await send({type: 'list', origin: ORIGIN});
+    if (list && list.items && list.items.length) {
+      renderFill(list.items);
+    }
+  }
+
+  document.addEventListener('submit', (event) => {
+    const creds = credentialsFrom(event.target);
+    if (!creds) return;
+    send({
+      type: 'submit',
+      origin: ORIGIN,
+      username: creds.username,
+      password: creds.password,
+      ts: Date.now(),
+    });
+  }, true);
+
+  document.addEventListener('keydown', (event) => {
+    if (event.key !== 'Enter') return;
+    const target = event.target;
+    if (!target || target.type !== 'password') return;
+    const creds = credentialsFrom(target);
+    if (!creds) return;
+    send({
+      type: 'submit',
+      origin: ORIGIN,
+      username: creds.username,
+      password: creds.password,
+      ts: Date.now(),
+    });
+  }, true);
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', () => {
+      onLoad();
+    }, {once: true});
+  } else {
+    onLoad();
+  }
+})();
diff --git a/chrome/browser/resources/local_vault/worker.js b/chrome/browser/resources/local_vault/worker.js
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/local_vault/worker.js
@@ -0,0 +1,316 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Device-only password vault: the storage and crypto half. Records live in
+// chrome.storage.local, which is app-private and never synced. With a PIN set,
+// every field is AES-GCM ciphertext under a PBKDF2 key derived from the PIN;
+// the PIN itself is never written anywhere.
+
+'use strict';
+
+const SETTINGS_KEY = 'lv_settings';
+const ITEMS_KEY = 'lv_items';
+const PENDING_KEY = 'lv_pending';
+const SESSION_KEY = 'lv_key';
+const PROBE = 'local-vault-probe-v1';
+const ITERATIONS = 210000;
+const MIN_PIN = 4;
+
+const encoder = new TextEncoder();
+const decoder = new TextDecoder();
+
+let unlockedKey = null;
+try {
+  chrome.storage.session.setAccessLevel({accessLevel: 'TRUSTED_CONTEXTS'});
+} catch (e) {
+  // Older engines without session storage still work, they just forget the
+  // unlocked key whenever the worker is torn down.
+}
+
+function toBase64(bytes) {
+  let binary = '';
+  const view = new Uint8Array(bytes);
+  for (let i = 0; i < view.length; i++) {
+    binary += String.fromCharCode(view[i]);
+  }
+  return btoa(binary);
+}
+
+function fromBase64(text) {
+  const binary = atob(text);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+async function readSettings() {
+  const stored = await chrome.storage.local.get(SETTINGS_KEY);
+  return stored[SETTINGS_KEY] || {mode: 'none'};
+}
+
+async function readItems() {
+  const stored = await chrome.storage.local.get(ITEMS_KEY);
+  return stored[ITEMS_KEY] || [];
+}
+
+async function writeItems(items) {
+  await chrome.storage.local.set({[ITEMS_KEY]: items});
+}
+
+async function readSession() {
+  if (!chrome.storage.session) return {};
+  try {
+    return await chrome.storage.session.get(SESSION_KEY);
+  } catch (e) {
+    return {};
+  }
+}
+
+async function writeSession(value) {
+  if (!chrome.storage.session) return;
+  try {
+    if (value === null) {
+      await chrome.storage.session.remove(SESSION_KEY);
+    } else {
+      await chrome.storage.session.set({[SESSION_KEY]: value});
+    }
+  } catch (e) {
+    // Nothing to do: the key is simply re-derived on the next unlock.
+  }
+}
+
+async function deriveKey(pin, saltBase64) {
+  const material = await crypto.subtle.importKey(
+      'raw', encoder.encode(pin), 'PBKDF2', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+      {
+        name: 'PBKDF2',
+        salt: fromBase64(saltBase64),
+        iterations: ITERATIONS,
+        hash: 'SHA-256',
+      },
+      material,
+      {name: 'AES-GCM', length: 256},
+      true,
+      ['encrypt', 'decrypt']);
+}
+
+async function seal(key, text) {
+  if (!key) return {iv: '', ct: toBase64(encoder.encode(text))};
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const cipher = await crypto.subtle.encrypt(
+      {name: 'AES-GCM', iv}, key, encoder.encode(text));
+  return {iv: toBase64(iv), ct: toBase64(cipher)};
+}
+
+async function open(key, blob) {
+  if (!blob) return '';
+  if (!blob.iv) return decoder.decode(fromBase64(blob.ct));
+  const plain = await crypto.subtle.decrypt(
+      {name: 'AES-GCM', iv: fromBase64(blob.iv)}, key, fromBase64(blob.ct));
+  return decoder.decode(plain);
+}
+
+async function restoreKey(settings) {
+  if (settings.mode !== 'pin') {
+    unlockedKey = null;
+    return null;
+  }
+  if (unlockedKey) return unlockedKey;
+  const session = await readSession();
+  const raw = session[SESSION_KEY];
+  if (!raw) return null;
+  try {
+    unlockedKey = await crypto.subtle.importKey(
+        'raw', fromBase64(raw), {name: 'AES-GCM'}, true, ['encrypt', 'decrypt']);
+  } catch (e) {
+    unlockedKey = null;
+  }
+  return unlockedKey;
+}
+
+async function unlockWith(settings, pin) {
+  if (!pin || !settings.salt) return false;
+  const key = await deriveKey(pin, settings.salt);
+  try {
+    const probe = await open(key, settings.probe);
+    if (probe !== PROBE) return false;
+  } catch (e) {
+    return false;
+  }
+  unlockedKey = key;
+  await writeSession(toBase64(await crypto.subtle.exportKey('raw', key)));
+  return true;
+}
+
+async function itemsFor(origin) {
+  const items = await readItems();
+  return items.filter((item) => item.origin === origin);
+}
+
+async function handle(message) {
+  const settings = await readSettings();
+  await restoreKey(settings);
+  const locked = settings.mode === 'pin' && !unlockedKey;
+
+  switch (message.type) {
+    case 'submit': {
+      const pending = {
+        origin: message.origin,
+        username: message.username || '',
+        password: message.password || '',
+        ts: message.ts || Date.now(),
+      };
+      if (!pending.password) return {ok: false};
+      if (chrome.storage.session) {
+        await chrome.storage.session.set({[PENDING_KEY]: pending});
+      } else {
+        await chrome.storage.local.set({[PENDING_KEY]: pending});
+      }
+      return {ok: true};
+    }
+
+    case 'takePending': {
+      const store = chrome.storage.session ? chrome.storage.session : chrome.storage.local;
+      const stored = await store.get(PENDING_KEY);
+      const pending = stored[PENDING_KEY];
+      if (!pending) return null;
+      await store.remove(PENDING_KEY);
+      if (pending.origin !== message.origin) return null;
+      return pending;
+    }
+
+    case 'dropPending': {
+      const store = chrome.storage.session ? chrome.storage.session : chrome.storage.local;
+      await store.remove(PENDING_KEY);
+      return {ok: true};
+    }
+
+    case 'list': {
+      if (locked) return {items: [], locked: true};
+      const items = await itemsFor(message.origin);
+      const listed = [];
+      for (const item of items) {
+        let username = '';
+        try {
+          username = await open(unlockedKey, item.u);
+        } catch (e) {
+          username = '';
+        }
+        listed.push({id: item.id, username});
+      }
+      return {items: listed};
+    }
+
+    case 'fill': {
+      if (locked) return {error: 'locked'};
+      const items = await itemsFor(message.origin);
+      const item = items.find((candidate) => candidate.id === message.id) || items[0];
+      if (!item) return {error: 'missing'};
+      try {
+        return {
+          username: await open(unlockedKey, item.u),
+          password: await open(unlockedKey, item.p),
+        };
+      } catch (e) {
+        return {error: 'locked'};
+      }
+    }
+
+    case 'unlock': {
+      if (settings.mode !== 'pin') return {ok: true};
+      const ok = await unlockWith(settings, message.pin);
+      return ok ? {ok: true} : {error: 'pin'};
+    }
+
+    case 'getSettings':
+      return {mode: settings.mode, unlocked: !locked};
+
+    case 'save': {
