Subject: [PATCH] Add a device-only password vault as a component extension

The Play services password manager cannot run here: its backend class is
Google-internal and an unbranded build always reports it missing, which leaves
the Autofill and passwords page with a dead row. This ships a component
extension instead: a thin bar under the toolbar offers to save a submitted
login and to fill a stored one, keeps records in chrome.storage.local
(app-private, never synced) and, with a PIN set, encrypts every field with
AES-GCM under a PBKDF2 key derived from the PIN.
---
diff --git a/chrome/browser/extensions/component_loader.cc b/chrome/browser/extensions/component_loader.cc
--- a/chrome/browser/extensions/component_loader.cc
+++ b/chrome/browser/extensions/component_loader.cc
@@ -110,6 +110,23 @@ BASE_FEATURE(kRemoveHangoutsExtension, base::FEATURE_DISABLED_BY_DEFAULT);
 
 bool g_enable_background_extensions_during_testing = false;
 
+// Local vault: a device-only password manager. It ships as a component
+// extension because the Play services password manager cannot exist in an
+// unbranded build, and a page-level vault needs no privileged API.
+constexpr char kLocalVaultManifest[] = R"json({
+  "manifest_version": 3,
+  "name": "Local vault",
+  "version": "1.0",
+  "description": "Saves passwords on this device only. Nothing is synced.",
+  "key": "",
+  "permissions": ["storage"],
+  "content_scripts": [{
+    "matches": ["<all_urls>"],
+    "js": ["content.js"],
+    "run_at": "document_idle"
+  }]
+})json";
+
 #if BUILDFLAG(IS_CHROMEOS) && BUILDFLAG(GOOGLE_CHROME_BRANDING)
 // Whether HelpApp is enabled.
 bool g_enable_help_app = true;
@@ -690,6 +707,12 @@ void ComponentLoader::AddDefaultComponentExtensions(
 
   if (!skip_session_components) {
     AddWebStoreApp();
+    const ExtensionId vault_id =
+        Add(kLocalVaultManifest, base::FilePath(FILE_PATH_LITERAL("local_vault")),
+            /*skip_allowlist=*/true);
+    // Visible in logcat with --enable-logging: empty means the manifest or the
+    // allowlist was rejected, and the reason is logged by ComponentLoader.
+    LOG(WARNING) << "local_vault: component extension id=" << vault_id;
 #if BUILDFLAG(IS_CHROMEOS)
     AddChromeApp();
 #endif  // BUILDFLAG(IS_CHROMEOS)
diff --git a/chrome/browser/resources/component_extension_resources.grd b/chrome/browser/resources/component_extension_resources.grd
--- a/chrome/browser/resources/component_extension_resources.grd
+++ b/chrome/browser/resources/component_extension_resources.grd
@@ -12,6 +12,7 @@
   </outputs>
   <release seq="1">
     <includes>
+      <include name="IDR_LOCAL_VAULT_CONTENT_JS" file="local_vault/content.js" type="BINDATA" />
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_JS" file="network_speech_synthesis/tts_extension.js" type="BINDATA" />
 
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_MV3_AUDIO_HTML" file="network_speech_synthesis/mv3/audio.html" type="BINDATA" />
diff --git a/chrome/browser/resources/local_vault/content.js b/chrome/browser/resources/local_vault/content.js
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/local_vault/content.js
@@ -0,0 +1,589 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Device-only password vault. Everything lives in this content script: the
+// records are in chrome.storage.local (app-private, never synced), the PIN key
+// is derived with WebCrypto and kept in chrome.storage.session (memory only),
+// and the UI is a thin bar pinned under the toolbar. There is no background
+// worker and no network call anywhere in this file.
+
+(() => {
+  if (window.top !== window) return;
+  const scheme = location.protocol;
+  if (scheme !== 'https:' && scheme !== 'http:') return;
+  if (window.__localVaultInjected) return;
+  window.__localVaultInjected = true;
+
+  const ORIGIN = location.origin;
+  const PENDING_TTL = 120000;
+  const ITERATIONS = 210000;
+  const PROBE = 'local-vault-probe-v1';
+  const MIN_PIN = 4;
+  const SETTINGS_KEY = 'lv_settings';
+  const ITEMS_KEY = 'lv_items';
+  const PENDING_KEY = 'lv_pending';
+  const KEY_STORAGE = 'lv_key';
+
+  const notes = [];
+  const hasStorage = !!(chrome && chrome.storage && chrome.storage.local);
+  const hasSession = !!(chrome && chrome.storage && chrome.storage.session);
+  const hasSubtle = !!(window.crypto && window.crypto.subtle);
+  if (!hasStorage) notes.push('storage=missing');
+  if (!hasSession) notes.push('session=missing');
+  if (!hasSubtle) notes.push('subtle=missing');
+  try {
+    if (hasSession && chrome.storage.session.setAccessLevel) {
+      chrome.storage.session.setAccessLevel({accessLevel: 'TRUSTED_AND_UNTRUSTED_CONTEXTS'});
+    }
+  } catch (e) {
+    notes.push('session-level=failed');
+  }
+  document.documentElement.setAttribute(
+      'data-local-vault', notes.length ? 'injected(' + notes.join(',') + ')' : 'injected');
+
+  let unlockedKey = null;
+  let host = null;
+  let shadow = null;
+  let root = null;
+
+  const encoder = new TextEncoder();
+  const decoder = new TextDecoder();
+
+  function toBase64(bytes) {
+    let binary = '';
+    const view = new Uint8Array(bytes);
+    for (let i = 0; i < view.length; i++) binary += String.fromCharCode(view[i]);
+    return btoa(binary);
+  }
+
+  function fromBase64(text) {
+    const binary = atob(text);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+    return bytes;
+  }
+
+  async function storeGet(keys) {
+    if (!hasStorage) return {};
+    return new Promise((resolve) => {
+      try {
+        chrome.storage.local.get(keys, (values) => {
+          void chrome.runtime.lastError;
+          resolve(values || {});
+        });
+      } catch (e) {
+        resolve({});
+      }
+    });
+  }
+
+  async function storeSet(values) {
+    if (!hasStorage) return false;
+    return new Promise((resolve) => {
+      try {
+        chrome.storage.local.set(values, () => {
+          void chrome.runtime.lastError;
+          resolve(true);
+        });
+      } catch (e) {
+        resolve(false);
+      }
+    });
+  }
+
+  async function sessionGet(key) {
+    if (!hasSession) return null;
+    return new Promise((resolve) => {
+      try {
+        chrome.storage.session.get(key, (values) => {
+          void chrome.runtime.lastError;
+          resolve((values || {})[key] || null);
+        });
+      } catch (e) {
+        resolve(null);
+      }
+    });
+  }
+
+  async function sessionSet(key, value) {
+    if (!hasSession) return;
+    return new Promise((resolve) => {
+      try {
+        if (value === null) {
+          chrome.storage.session.remove(key, () => {
+            void chrome.runtime.lastError;
+            resolve();
+          });
+        } else {
+          chrome.storage.session.set({[key]: value}, () => {
+            void chrome.runtime.lastError;
+            resolve();
+          });
+        }
+      } catch (e) {
+        resolve();
+      }
+    });
+  }
+
+  async function settings() {
+    const stored = await storeGet(SETTINGS_KEY);
+    return stored[SETTINGS_KEY] || {mode: 'none'};
+  }
+
+  async function items() {
+    const stored = await storeGet(ITEMS_KEY);
+    return stored[ITEMS_KEY] || [];
+  }
+
+  async function deriveKey(pin, salt) {
+    const material = await crypto.subtle.importKey(
+        'raw', encoder.encode(pin), 'PBKDF2', false, ['deriveKey']);
+    return crypto.subtle.deriveKey(
+        {
+          name: 'PBKDF2',
+          salt: fromBase64(salt),
+          iterations: ITERATIONS,
+          hash: 'SHA-256',
+        },
+        material,
+        {name: 'AES-GCM', length: 256},
+        true,
+        ['encrypt', 'decrypt']);
+  }
+
+  async function seal(key, text) {
+    if (!key) return {iv: '', ct: toBase64(encoder.encode(text))};
+    if (!hasSubtle) throw new Error('no-subtle');
+    const iv = crypto.getRandomValues(new Uint8Array(12));
+    const cipher = await crypto.subtle.encrypt({name: 'AES-GCM', iv}, key, encoder.encode(text));
+    return {iv: toBase64(iv), ct: toBase64(cipher)};
+  }
+
+  async function open(key, blob) {
+    if (!blob) return '';
+    if (!blob.iv) return decoder.decode(fromBase64(blob.ct));
+    if (!hasSubtle) throw new Error('no-subtle');
+    const plain = await crypto.subtle.decrypt(
+        {name: 'AES-GCM', iv: fromBase64(blob.iv)}, key, fromBase64(blob.ct));
+    return decoder.decode(plain);
+  }
+
+  async function restoreKey() {
+    const config = await settings();
+    if (config.mode !== 'pin') {
+      unlockedKey = null;
+      return null;
+    }
+    if (unlockedKey) return unlockedKey;
+    const raw = await sessionGet(KEY_STORAGE);
+    if (!raw) return null;
+    try {
+      unlockedKey = await crypto.subtle.importKey(
+          'raw', fromBase64(raw), {name: 'AES-GCM'}, true, ['encrypt', 'decrypt']);
+    } catch (e) {
+      unlockedKey = null;
+    }
+    return unlockedKey;
+  }
+
+  async function unlock(config, pin) {
+    if (!pin || !config.salt || !hasSubtle) return false;
+    const key = await deriveKey(pin, config.salt);
+    try {
+      if (await open(key, config.probe) !== PROBE) return false;
+    } catch (e) {
+      return false;
+    }
+    unlockedKey = key;
+    await sessionSet(KEY_STORAGE, toBase64(await crypto.subtle.exportKey('raw', key)));
+    return true;
+  }
+
+  const STYLE = `
+    :host { all: initial; }
+    .bar {
+      position: fixed; top: 0; left: 0; right: 0;
+      display: flex; align-items: center; gap: 6px;
+      min-height: 40px; padding: 0 10px;
+      box-sizing: border-box;
+      background: #292a2d; color: #e8eaed;
+      font: 13px/18px Roboto, system-ui, sans-serif;
+      box-shadow: 0 1px 4px rgba(0,0,0,.5);
+      z-index: 2147483647;
+    }
+    .text { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+    .sub { color: #9aa0a6; font-size: 11px; display: block; }
+    button {
+      all: unset; cursor: pointer; padding: 6px 10px; border-radius: 16px;
+      font: 500 13px/18px Roboto, system-ui, sans-serif; color: #8ab4f8;
+    }
+    button.solid { background: #8ab4f8; color: #202124; }
+    button.icon { padding: 6px 8px; color: #9aa0a6; }
+    input {
+      all: unset; background: #1f2023; color: #e8eaed; border-radius: 6px;
+      padding: 5px 8px; width: 110px; font: 13px Roboto, system-ui, sans-serif;
+    }
+    .row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+    .settings { background: #292a2d; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
+    label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
+    .hint { color: #9aa0a6; font-size: 11px; }
+  `;
+
+  function build() {
+    if (host) return;
+    host = document.createElement('div');
+    host.id = 'local-vault-bar';
+    host.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:2147483647;';
+    shadow = host.attachShadow({mode: 'open'});
+    const style = document.createElement('style');
+    style.textContent = STYLE;
+    shadow.appendChild(style);
+    root = document.createElement('div');
+    shadow.appendChild(root);
+    (document.body || document.documentElement).appendChild(host);
+  }
+
+  function el(tag, props, ...children) {
+    const node = document.createElement(tag);
+    Object.assign(node, props || {});
+    for (const child of children) node.append(child);
+    return node;
+  }
+
+  function label(main, sub) {
+    const wrap = el('div', {className: 'text'});
+    wrap.append(document.createTextNode(main));
+    if (sub) wrap.append(el('span', {className: 'sub'}, document.createTextNode(sub)));
+    return wrap;
+  }
+
+  function hide() {
+    if (host) host.style.display = 'none';
+  }
+
+  function show(children) {
+    build();
+    while (root.firstChild) root.removeChild(root.firstChild);
+    const bar = el('div', {className: 'bar'});
+    for (const child of children) bar.append(child);
+    root.append(bar);
+    host.style.display = 'block';
+  }
+
+  function pinPrompt(intro, onSubmit) {
+    const input = el('input', {type: 'password', placeholder: 'PIN', maxLength: 32});
+    const error = el('span', {className: 'sub'});
+    const submit = async () => {
+      const config = await settings();
+      if (await unlock(config, input.value)) {
+        onSubmit();
+      } else {
+        error.textContent = hasSubtle ? 'Wrong PIN' : 'PIN lock needs https';
+      }
+    };
+    const go = el('button', {className: 'solid', textContent: 'Unlock', onclick: submit});
+    input.onkeydown = (event) => {
+      if (event.key === 'Enter') submit();
+    };
+    show([
+      label(intro, 'Local vault is locked'),
+      input,
+      go,
+      el('button', {textContent: 'Cancel', onclick: hide}),
+      error,
+    ]);
+    setTimeout(() => input.focus(), 0);
+  }
+
+  function passwordFields(scope) {
+    return Array.from(scope.querySelectorAll('input[type="password"]'))
+        .filter((input) => !input.disabled);
+  }
+
+  function usernameField(scope, password) {
+    const inputs = Array.from(scope.querySelectorAll(
+        'input:not([type]), input[type="text"], input[type="email"], input[type="tel"]'));
+    let best = null;
+    for (const input of inputs) {
+      if (input.disabled) continue;
+      if (input.compareDocumentPosition(password) & Node.DOCUMENT_POSITION_FOLLOWING) best = input;
+    }
+    const named = scope.querySelector('input[autocomplete*="username"]');
+    if (named && !named.disabled) return named;
+    return best;
+  }
+
+  function credentialsFrom(node) {
+    const form = node && node.closest ? node.closest('form') : null;
+    const scope = form || document;
+    const password = passwordFields(scope)[0];
+    if (!password || !password.value) return null;
+    const username = usernameField(scope, password);
+    return {username: username ? username.value.trim() : '', password: password.value};
+  }
+
+  function setValue(input, value) {
+    const proto = input instanceof HTMLTextAreaElement ?
+        HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
+    const setter = Object.getOwnPropertyDescriptor(proto, 'value');
+    if (setter && setter.set) {
+      setter.set.call(input, value);
+    } else {
+      input.value = value;
+    }
+    input.dispatchEvent(new Event('input', {bubbles: true}));
+    input.dispatchEvent(new Event('change', {bubbles: true}));
+  }
+
+  async function saveCredential(origin, username, password) {
+    const config = await settings();
+    const key = await restoreKey();
+    if (config.mode === 'pin' && !key) return {error: 'locked'};
+    if (!password) return {error: 'empty'};
+    const list = await items();
+    let replaced = false;
+    for (const item of list) {
+      if (item.origin !== origin) continue;
+      let storedUser = '';
+      try {
+        storedUser = await open(key, item.u);
+      } catch (e) {
+        continue;
+      }
+      if (storedUser === username) {
+        item.u = await seal(key, username);
+        item.p = await seal(key, password);
+        replaced = true;
+        break;
+      }
+    }
+    if (!replaced) {
+      list.push({
+        id: (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random()),
+        origin,
+        u: await seal(key, username),
+        p: await seal(key, password),
+      });
+    }
+    await storeSet({[ITEMS_KEY]: list});
+    return {ok: true};
+  }
+
+  async function fillWith(id) {
+    const key = await restoreKey();
+    const list = (await items()).filter((item) => item.origin === ORIGIN);
+    const item = list.find((candidate) => candidate.id === id) || list[0];
+    if (!item) return;
+    const password = passwordFields(document)[0];
+    if (!password) return;
+    const username = usernameField(password.closest('form') || document, password);
+    if (username) setValue(username, await open(key, item.u));
+    setValue(password, await open(key, item.p));
+    hide();
+  }
+
+  async function handleFill(id) {
+    const config = await settings();
+    const key = await restoreKey();
+    if (config.mode === 'pin' && !key) {
+      pinPrompt('Enter your PIN to fill', () => handleFill(id));
+      return;
+    }
+    await fillWith(id);
+  }
+
+  async function handleSave(origin, username, password) {
+    const config = await settings();
+    const key = await restoreKey();
+    if (config.mode === 'pin' && !key) {
+      pinPrompt('Enter your PIN to save', () => handleSave(origin, username, password));
+      return;
+    }
+    const result = await saveCredential(origin, username, password);
+    if (result && result.ok) {
+      await storeSet({[PENDING_KEY]: null});
+      hide();
+    }
+  }
+
+  function renderSettings(config) {
+    const none = el('input', {type: 'radio', name: 'lv-mode', value: 'none'});
+    none.checked = config.mode !== 'pin';
+    const pin = el('input', {type: 'radio', name: 'lv-mode', value: 'pin'});
+    pin.checked = config.mode === 'pin';
+    const pin1 = el('input', {type: 'password', placeholder: 'PIN', maxLength: 32});
+    const pin2 = el('input', {type: 'password', placeholder: 'Repeat PIN', maxLength: 32});
+    const status = el('div', {className: 'hint'});
+    const save = el('button', {className: 'solid', textContent: 'Save settings'});
+    save.onclick = async () => {
+      const mode = pin.checked ? 'pin' : 'none';
+      const value = pin1.value;
+      if (mode === 'pin' && !hasSubtle) {
+        status.textContent = 'A PIN needs a https page or an extension page.';
+        return;
+      }
+      if (mode === 'pin' && value.length < MIN_PIN) {
+        status.textContent = 'PIN must be at least ' + MIN_PIN + ' characters.';
+        return;
+      }
+      if (mode === 'pin' && value !== pin2.value) {
+        status.textContent = 'PINs do not match.';
+        return;
+      }
+      const current = await settings();
+      const key = current.mode === 'pin' ? await restoreKey() : null;
+      if (current.mode === 'pin' && !key) {
+        status.textContent = 'Unlock first, then change the lock.';
+        return;
+      }
+      const list = await items();
+      if (mode === 'none') {
+        const plain = [];
+        for (const item of list) {
+          plain.push({
+            id: item.id,
+            origin: item.origin,
+            u: await seal(null, await open(key, item.u)),
+            p: await seal(null, await open(key, item.p)),
+          });
+        }
+        await storeSet({[ITEMS_KEY]: plain, [SETTINGS_KEY]: {mode: 'none'}});
+        unlockedKey = null;
+        await sessionSet(KEY_STORAGE, null);
+        hide();
+        return;
+      }
+      const salt = toBase64(crypto.getRandomValues(new Uint8Array(16)));
+      const next = await deriveKey(value, salt);
+      const sealed = [];
+      for (const item of list) {
+        sealed.push({
+          id: item.id,
+          origin: item.origin,
+          u: await seal(next, await open(key, item.u)),
+          p: await seal(next, await open(key, item.p)),
+        });
+      }
+      await storeSet({
+        [ITEMS_KEY]: sealed,
+        [SETTINGS_KEY]: {mode: 'pin', salt, probe: await seal(next, PROBE)},
+      });
+      unlockedKey = next;
+      await sessionSet(KEY_STORAGE, toBase64(await crypto.subtle.exportKey('raw', next)));
+      hide();
+    };
+    build();
+    while (root.firstChild) root.removeChild(root.firstChild);
+    root.append(el('div', {className: 'bar'},
+        label('Local vault', 'Device-only password storage'),
+        el('button', {className: 'icon', textContent: '\u2715', onclick: hide})));
+    const panel = el('div', {className: 'settings'},
+        el('label', {}, none, document.createTextNode('Open without a PIN')),
+        el('label', {}, pin, document.createTextNode('Lock with a PIN')),
+        el('div', {className: 'row'}, pin1, pin2),
+        el('div', {className: 'hint'},
+            document.createTextNode('The PIN is never stored. It derives the AES key.')),
+        el('div', {className: 'row'}, save, status));
+    root.append(panel);
+    host.style.display = 'block';
+  }
+
+  async function onLoad() {
+    const stored = await storeGet(PENDING_KEY);
+    const pending = stored[PENDING_KEY];
+    if (pending && pending.origin === ORIGIN && Date.now() - pending.ts < PENDING_TTL) {
+      await storeSet({[PENDING_KEY]: null});
+      const where = pending.username || 'this site';
+      show([
+        label('Save password?', where),
+        el('button', {
+          className: 'solid',
+          textContent: 'Save',
+          onclick: () => handleSave(pending.origin, pending.username, pending.password),
+        }),
+        el('button', {textContent: 'Not now', onclick: hide}),
+      ]);
+      return;
+    }
+
+    const config = await settings();
+    const key = await restoreKey();
+    const list = (await items()).filter((item) => item.origin === ORIGIN);
+    const gear = el('button', {
+      className: 'icon',
+      textContent: '\u2699',
+      onclick: () => renderSettings(config),
+    });
+
+    if (list.length && !key && config.mode === 'pin') {
+      show([
+        label('Fill password?', list.length > 1 ? list.length + ' accounts' : 'saved login'),
+        el('button', {
+          className: 'solid',
+          textContent: 'Unlock',
+          onclick: () => pinPrompt('Enter your PIN to fill', onLoad),
+        }),
+        el('button', {textContent: 'Not now', onclick: hide}),
+        gear,
+      ]);
+      return;
+    }
+
+    if (list.length) {
+      const first = list[0];
+      let where = '';
+      try {
+        where = await open(key, first.u);
+      } catch (e) {
+        where = '';
+      }
+      show([
+        label('Fill password?',
+            list.length > 1 ? list.length + ' accounts' : (where || 'saved login')),
+        el('button', {className: 'solid', textContent: 'Fill', onclick: () => handleFill(first.id)}),
+        el('button', {textContent: 'Not now', onclick: hide}),
+        gear,
+      ]);
+      return;
+    }
+
+    // Nothing saved for this origin: stay out of the way unless this looks like a
+    // login page, and then only for a few seconds.
+    if (!passwordFields(document).length) return;
+    show([
+      label('Local vault', config.mode === 'pin' ? 'Locked, nothing saved here' : 'Nothing saved here'),
+      gear,
+      el('button', {textContent: 'Hide', onclick: hide}),
+    ]);
+    setTimeout(() => {
+      if (host && host.style.display !== 'none') hide();
+    }, 12000);
+  }
+
+  function capture(node) {
+    const creds = credentialsFrom(node);
+    if (!creds) return;
+    storeSet({[PENDING_KEY]: {
+      origin: ORIGIN,
+      username: creds.username,
