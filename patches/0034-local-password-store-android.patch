Subject: [PATCH] Build the local password store on Android

An unbranded build reports the Play services password backend as missing, so
every password path is disabled and the login database is never compiled. This
enables the built-in store for Android: the login database and its helper are
built, the backend factory returns the built-in backend instead of the GMS one,
availability reports true, and the store opens without an OS keychain.

Credentials land in the app-private login database. Encryption is not wired yet,
which is why this stays behind the experiment and not the default path.
diff --git a/chrome/browser/password_manager/android/password_manager_android_util.cc b/chrome/browser/password_manager/android/password_manager_android_util.cc
--- a/chrome/browser/password_manager/android/password_manager_android_util.cc
+++ b/chrome/browser/password_manager/android/password_manager_android_util.cc
@@ -32,14 +32,11 @@ bool IsPasswordManagerAvailable(
 }
 
 bool IsPasswordManagerAvailable(bool is_internal_backend_present) {
-  if (!is_internal_backend_present) {
-    return false;
+  // An unbranded build has no Play services password backend, but it does ship
+  // the local login database, so storage works either way.
+  if (is_internal_backend_present) {
+    return HasMinGmsVersionForFullUpmSupport();
   }
-
-  if (!HasMinGmsVersionForFullUpmSupport()) {
-    return false;
-  }
-
   return true;
 }
 
diff --git a/components/password_manager/core/browser/password_store/BUILD.gn b/components/password_manager/core/browser/password_store/BUILD.gn
--- a/components/password_manager/core/browser/password_store/BUILD.gn
+++ b/components/password_manager/core/browser/password_store/BUILD.gn
@@ -87,9 +87,11 @@ source_set("password_store_impl") {
       "//components/sync/base",
       "//components/sync/service",
     ]
-  } else {
-    sources += [
-      "insecure_credentials_table.cc",
+  }
+
+  # The local login database is the only store an unbranded build can use.
+  sources += [
+    "insecure_credentials_table.cc",
       "insecure_credentials_table.h",
       "login_database.cc",
       "login_database.h",
@@ -114,7 +116,6 @@ source_set("password_store_impl") {
     if (is_win) {
       sources += [ "login_database_win.cc" ]
     }
-  }
   configs += [ "//build/config/compiler:wexit_time_destructors" ]
 }
 
diff --git a/components/password_manager/core/browser/password_store_factory_util.cc b/components/password_manager/core/browser/password_store_factory_util.cc
--- a/components/password_manager/core/browser/password_store_factory_util.cc
+++ b/components/password_manager/core/browser/password_store_factory_util.cc
@@ -21,15 +21,12 @@
 #include "components/password_manager/core/common/password_manager_pref_names.h"
 #include "components/prefs/pref_service.h"
 
-#if !BUILDFLAG(IS_ANDROID)
 #include "components/password_manager/core/browser/password_store/login_database.h"
-#endif  // !BUILDFLAG(IS_ANDROID)
 
 namespace password_manager {
 
 namespace {
 
-#if !BUILDFLAG(IS_ANDROID)
 LoginDatabase::DeletingUndecryptablePasswordsEnabled GetPolicyFromPrefs(
     PrefService* prefs) {
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
@@ -40,22 +37,28 @@ LoginDatabase::DeletingUndecryptablePasswordsEnabled GetPolicyFromPrefs(
   return LoginDatabase::DeletingUndecryptablePasswordsEnabled(true);
 #endif
 }
-#endif  // !BUILDFLAG(IS_ANDROID)
 
 }  // namespace
 
-#if !BUILDFLAG(IS_ANDROID)
 std::unique_ptr<LoginDatabase> CreateLoginDatabase(
     password_manager::IsAccountStore is_account_store,
     const base::FilePath& db_directory,
     PrefService* prefs) {
+#if BUILDFLAG(IS_ANDROID)
+  // Those file names are declared for desktop builds only upstream.
+  base::FilePath login_db_file_path = db_directory.Append(
+      is_account_store ? base::FilePath::StringType(FILE_PATH_LITERAL(
+                             "Login Data For Account"))
+                       : base::FilePath::StringType(FILE_PATH_LITERAL(
+                             "Login Data")));
+#else
   base::FilePath login_db_file_path =
       db_directory.Append(is_account_store ? kLoginDataForAccountFileName
                                            : kLoginDataForProfileFileName);
+#endif
   return std::make_unique<LoginDatabase>(login_db_file_path, is_account_store,
                                          GetPolicyFromPrefs(prefs));
 }
-#endif  // !BUILDFLAG(IS_ANDROID)
 
