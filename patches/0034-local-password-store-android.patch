Subject: [PATCH] Build the local password store on Android

An unbranded build reports the Play services password backend as missing, so
every password path is disabled and the login database is never compiled. This
enables the built-in store for Android: the login database and its helper are
built, the backend factory returns the built-in backend, availability reports
true, and the store opens without an OS keychain.

Credentials land in the app-private login database. Encryption is not wired yet.
diff --git a/chrome/browser/password_manager/android/password_manager_android_util.cc b/chrome/browser/password_manager/android/password_manager_android_util.cc
--- a/chrome/browser/password_manager/android/password_manager_android_util.cc
+++ b/chrome/browser/password_manager/android/password_manager_android_util.cc
@@ -32,14 +32,11 @@ bool IsPasswordManagerAvailable(
 }
 
 bool IsPasswordManagerAvailable(bool is_internal_backend_present) {
-  if (!is_internal_backend_present) {
-    return false;
+  // An unbranded build has no Play services password backend, but it does ship
+  // the local login database, so storage works either way.
+  if (is_internal_backend_present) {
+    return HasMinGmsVersionForFullUpmSupport();
   }
-
-  if (!HasMinGmsVersionForFullUpmSupport()) {
-    return false;
-  }
-
   return true;
 }
 
diff --git a/components/password_manager/core/browser/password_store/BUILD.gn b/components/password_manager/core/browser/password_store/BUILD.gn
--- a/components/password_manager/core/browser/password_store/BUILD.gn
+++ b/components/password_manager/core/browser/password_store/BUILD.gn
@@ -87,9 +87,11 @@ source_set("password_store_impl") {
       "//components/sync/base",
       "//components/sync/service",
     ]
-  } else {
-    sources += [
-      "insecure_credentials_table.cc",
+  }
+
+  # The local login database is the only store an unbranded build can use.
+  sources += [
+    "insecure_credentials_table.cc",
       "insecure_credentials_table.h",
       "login_database.cc",
       "login_database.h",
@@ -114,7 +116,6 @@ source_set("password_store_impl") {
     if (is_win) {
       sources += [ "login_database_win.cc" ]
     }
-  }
   configs += [ "//build/config/compiler:wexit_time_destructors" ]
 }
 
diff --git a/components/password_manager/core/browser/password_store/password_store_built_in_backend.cc b/components/password_manager/core/browser/password_store/password_store_built_in_backend.cc
