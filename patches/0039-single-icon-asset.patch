HcmV?d00001

diff --git a/ci/stage.sh b/ci/stage.sh
index 217770f..a0584e5 100644
--- a/ci/stage.sh
+++ b/ci/stage.sh
@@ -275,6 +275,16 @@ if [ "$HAVE" != "$WANT" ]; then
   git checkout -f -- . || fail patch "git checkout -- ."
   git clean -fdq || true
   bash "$ROOT/apply.sh" "$SRC" || fail patch "patch series does not apply"
+  # One image for every launcher icon: the prepared assets replace whatever the
+  # patch series left behind, at the density each resource expects.
+  if [ -d "$ROOT/assets/icons" ]; then
+    log "overlaying project icons"
+    ( cd "$ROOT/assets/icons" && find . -type f -name '*.png' -print0 |
+        while IFS= read -r -d '' icon; do
+          dest="$SRC/${icon#./}"
+          [ -f "$dest" ] && cp "$icon" "$dest"
+        done )
+  fi
   printf '%s' "$WANT" > "$STATE"
 else
   log "patches already applied for this version"
