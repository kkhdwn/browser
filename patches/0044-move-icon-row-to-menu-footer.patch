Subject: [PATCH] Move the app-menu icon row to a fixed footer

Render the three-dots menu icon row (back, forward, bookmark, download,
reload) as a fixed, non-scrolling footer at the bottom of the menu instead
of the first scrollable list item.

---
diff --git a/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuCoordinatorFactory.java b/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuCoordinatorFactory.java
--- a/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuCoordinatorFactory.java
+++ b/chrome/browser/ui/android/appmenu/internal/java/src/org/chromium/chrome/browser/ui/appmenu/AppMenuCoordinatorFactory.java
@@ -6,6 +6,7 @@
 
 import android.content.Context;
 import android.graphics.Rect;
+import android.view.LayoutInflater;
 import android.view.View;
 
 import org.chromium.base.Callback;
@@ -14,6 +15,8 @@
 import org.chromium.chrome.browser.lifecycle.ActivityLifecycleDispatcher;
+import org.chromium.chrome.browser.ui.appmenu.internal.R;
 import org.chromium.ui.base.WindowAndroid;
 import org.chromium.ui.hierarchicalmenu.HierarchicalMenuController.SubmenuHeaderFactory;
+import org.chromium.ui.modelutil.PropertyModel;
 
 import java.util.function.Supplier;
 
@@ -70,4 +72,15 @@
     public static void setExceptionReporter(Callback<Throwable> reporter) {
         AppMenuCoordinatorImpl.setExceptionReporter(reporter);
     }
+
+    /**
+     * Inflates and binds the app-menu icon row. Used by the tabbed delegate to render the row as
+     * a fixed (non-scrolling) footer, since {@link AppMenuItemViewBinder} is package-private.
+     */
+    public static View createIconRowView(Context context, PropertyModel model) {
+        View view = LayoutInflater.from(context).inflate(R.layout.icon_row_menu_item, null);
+        AppMenuItemViewBinder.bindIconRowItem(
+                model, view, AppMenuItemProperties.ADDITIONAL_ICONS);
+        return view;
+    }
 }

